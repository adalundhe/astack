{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "./bin/astack-go-hook --harness cursor --event beforeShellExecution"
      }
    ],
    "beforeReadFile": [
      {
        "command": "./bin/astack-go-hook --harness cursor --event beforeReadFile"
      }
    ],
    "afterFileEdit": [
      {
        "command": "./bin/astack-stamp-hook"
      }
    ],
    "afterShellExecution": [
      {
        "command": "./bin/astack-stamp-hook"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./bin/astack-go-hook --harness cursor --event beforeSubmitPrompt"
      }
    ],
    "sessionStart": [
      {
        "command": "./bin/astack-go-hook --harness cursor --event sessionStart"
      }
    ]
  }
}
