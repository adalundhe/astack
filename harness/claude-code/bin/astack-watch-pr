# Forbidden internal bookkeeping tokens blocked on human-facing PR replies (/leave-feedback gate)
FORBIDDEN_REPLY_PATTERNS: Tuple[Tuple[str, re.Pattern[str]], ...] = (
    ("internal file reference (LANES.md)", re.compile(r"\bLANES\.md\b")),
    ("internal file reference (RULES.md)", re.compile(r"\bRULES\.md\b")),
    ("internal file reference (coverage-map.md)", re.compile(r"\bcoverage-map\.md\b")),
    ("internal ledger status (POOL EXHAUSTED)", re.compile(r"\bPOOL\s+EXHAUSTED\b", re.IGNORECASE)),
    ("internal ledger status (NOT ASSIGNED)", re.compile(r"\bNOT\s+ASSIGNED\b")),
    ("internal ledger status (STOPPED (...))", re.compile(r"\bSTOPPED\s*\((?:saturated|estimate|clean)\b", re.IGNORECASE)),
    ("internal review estimator jargon", re.compile(r"\b(?:capture[- ]recapture|Burnham[- ]Overton|jackknife|astack-review-ledger|astack-dispatch)\b", re.IGNORECASE)),
    ("bracketed internal rule/skill tag", re.compile(r"\[(?:rule|skill):\s*[a-z0-9-]+\]", re.IGNORECASE)),
    ("internal priority code (P0-P5)", re.compile(r"(?:^|[\s(\[])P[0-5](?:[\s:)\]-]|$)", re.MULTILINE)),
    ("internal harness/reviewer-pool state", re.compile(r"\b(?:reviewer_pool|(?:single|1)[- ]model\s+(?:reviewer\s+)?pool|TOOLS\.md)\b", re.IGNORECASE)),
)
BARE_SHA_START_RE = re.compile(r"(?:^|\n)\s*[0-9a-f]{7,40}\s+(?:says|shows|did|added|changed|bootstrapped|fixed)\b")

ANSI_ESCAPE_RE = re.compile(
    r"\x1b(?:\[[0-9;?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[@-Z\\-_])"
)
CONTROL_CHAR_RE = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f]")
HTML_COMMENT_RE = re.compile(r"<!--.*?-->", re.DOTALL)
HTML_TAG_RE = re.compile(r"<[^>]+>")


class ForgeKind(str, Enum):
    GITHUB = "github"
    GITLAB = "gitlab"
    BITBUCKET_CLOUD = "bitbucket-cloud"
    BITBUCKET_SERVER = "bitbucket-server"


class PRLifecycle(str, Enum):
    OPEN = "open"
    MERGED = "merged"
    CLOSED = "closed"


class CheckState(str, Enum):
    PASSED = "passed"
    PENDING = "pending"
    FAILED = "failed"
    CANCELLED = "cancelled"
    SKIPPED = "skipped"
    APPROVAL_GATE = "approval_gate"


class Mergeability(str, Enum):
    CLEAN = "clean"
    BEHIND = "behind"
    CONFLICTING = "conflicting"
    BLOCKED = "blocked"
    UNSTABLE = "unstable"
    DRAFT = "draft"
    UNKNOWN = "unknown"


class ReviewVerdict(str, Enum):
    APPROVED = "approved"
    CHANGES_REQUESTED = "changes_requested"
    REVIEW_REQUIRED = "review_required"
    NONE = "none"


class PRState(str, Enum):
    MERGED = "merged"
    CLOSED = "closed"
    NEEDS_REBASE = "needs_rebase"
    NEEDS_FEEDBACK = "needs_feedback"
    CI_FAILED = "ci_failed"
    DRAFT = "draft"
    HELD = "held"
    CI_PENDING = "ci_pending"
    WAITING_APPROVAL = "waiting_approval"
    STUCK_24H = "stuck_24h"
    MERGE_READY = "merge_ready"
    API_ERROR = "api_error"


class ActionKind(str, Enum):
    NONE = "none"
    REBASE_BRANCH = "rebase_branch"
    ADDRESS_COMMENTS = "address_comments"
    FIX_CI = "fix_ci"
    PING_STUCK_24H = "ping_stuck_24h"
    NOTIFY_MERGE_READY = "notify_merge_ready"


class WatcherError(Exception):
    """Base typed boundary error for PR watchers."""


class BadInputError(WatcherError):
    """Invalid arguments, target URL, or lock contention (exit 2)."""


class ForgeAuthError(WatcherError):
    """Authentication or authorization failure (non-retryable, exit 2)."""


class ForgeNotFoundError(WatcherError):
    """Target repository or pull/merge request not found (non-retryable, exit 2)."""


class ForgeRateLimitError(WatcherError):
    """Forge API rate limit reached (retryable after reset_in seconds)."""

    def __init__(self, message: str, retry_after: float, resource: str = "core") -> None:
        super().__init__(message)
        self.retry_after = max(1.0, float(retry_after))
        self.resource = resource


class ForgeTransientError(WatcherError):
    """Transient HTTP 5xx or network error (retryable with backoff)."""


@dataclass(frozen=True)
class PRTarget:
    forge: ForgeKind
    host: str
    repo: str
    number: int
    url: str = ""
    api_url: str = ""
    api_style: str = ""

    @property
    def key(self) -> str:
        safe_host = re.sub(r"[^a-zA-Z0-9._-]+", "_", self.host)
        safe_repo = re.sub(r"[^a-zA-Z0-9._-]+", "__", self.repo)
        return f"{self.forge.value}__{safe_host}__{safe_repo}__{self.number}"

    @property
    def display_ref(self) -> str:
        prefix = "!" if self.forge == ForgeKind.GITLAB else "#"
        return f"{self.repo}{prefix}{self.number}"


