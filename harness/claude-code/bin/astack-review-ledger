#!/usr/bin/env python3
"""Thin CLI entrypoint for `astack-review-ledger` (implementation lives in `lib/astack_ledger/`).

Usage:
  astack-review-ledger [INPUT.json | -] [--calibration FILE] [--outcomes FILE] [--receipts PATH ...] [--json | --markdown | --lanes]
  astack-review-ledger score [INPUT.json | -] [--repo DIR] [--base REF] [--head REF] [--pairs FILE] [--horizon N] [--max-commits N] [--json]

Exit codes:
  0 = evaluated or scored successfully
  2 = invalid input, schema error, or unapproved reviewer model
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path


def _bootstrap_lib() -> None:
    here = Path(__file__).resolve().parent
    for candidate in (here.parent / "lib", here / "_astack_lib"):
        if (candidate / "astack_ledger" / "__init__.py").is_file():
            path_str = str(candidate)
            if path_str not in sys.path:
                sys.path.insert(0, path_str)
            return


_bootstrap_lib()
from astack_ledger import (  # noqa: E402
    CatchRate,
    ValidationError,
    check_finder_diagnostics,
    evaluate_ledger,
    extract_git_baseline,
    format_markdown,
    load_calibration_file,
    load_dispatch_receipts,
    load_outcomes_file,
    score_vectors,
)


def _run_score(argv: list[str]) -> int:
    p = argparse.ArgumentParser(
        prog="astack-review-ledger score",
        description="Score arbitrary review vectors in [0, 1) using git baseline features or agent-supplied atoms/pairs.",
    )
    p.add_argument("input", nargs="?", default="", help="Optional JSON input file or '-' for stdin")
    p.add_argument("--repo", default="", help="Git repository path for universal git-only baseline & finder diagnostics")
    p.add_argument("--base", default="", help="Base ref for candidate change (used with --repo)")
    p.add_argument("--head", default="HEAD", help="Head ref for candidate change (default: HEAD)")
    p.add_argument("--pairs", default="", help="Optional JSON file of agent-built (introducing_commit, fix_commit) pairs")
    p.add_argument("--horizon", type=float, default=None, help="Closed horizon enforced by scorer")
    p.add_argument("--max-commits", type=int, default=None, help="Optional max git commits cap for baseline extraction (default: full history)")
    p.add_argument("--json", action="store_true", dest="as_json", help="Emit JSON output")
    args = p.parse_args(argv)

    try:
        payload: dict = {}
        if args.input == "-":
            payload = json.loads(sys.stdin.read())
        elif args.input:
            payload = json.loads(Path(args.input).read_text(encoding="utf-8"))

        pairs = None
        if args.pairs:
            raw_p = json.loads(Path(args.pairs).read_text(encoding="utf-8"))
            pairs = raw_p.get("pairs") if isinstance(raw_p, dict) else raw_p

        if args.repo and not payload.get("train_atoms"):
            base_data = extract_git_baseline(
                Path(args.repo).expanduser().resolve(),
                base=args.base,
                head=args.head,
                max_commits=args.max_commits,
                horizon_commits=int(args.horizon) if args.horizon is not None else None,
                pairs=pairs,
                extra_features=payload.get("extra_features"),
            )
            vectors = payload.get("vectors") or [
                {"name": "change", "atoms": [a["atom_id"] for a in base_data["candidate_atoms"]]}
            ]
            result = score_vectors(
                vectors,
                train_atoms=base_data["train_atoms"],
                candidate_atoms=base_data["candidate_atoms"],
                horizon=base_data["horizon"],
                max_order=base_data["max_order"],
                past_vectors=payload.get("past_vectors"),
                phi=payload.get("phi"),
                target=str(payload.get("target") or "traced_fix_within_horizon"),
                finder_checks=base_data["finder_checks"],
            )
            result["source"] = base_data["source"]
        else:
            fc = payload.get("finder_checks")
            if args.repo and pairs is not None and fc is None:
                fc = check_finder_diagnostics(Path(args.repo).expanduser().resolve(), pairs, max_commits=args.max_commits)
            result = score_vectors(
                payload.get("vectors") or [],
                train_atoms=payload.get("train_atoms"),
                candidate_atoms=payload.get("candidate_atoms"),
                horizon=args.horizon if args.horizon is not None else payload.get("horizon"),
                max_order=payload.get("max_order"),
                past_vectors=payload.get("past_vectors"),
                phi=payload.get("phi"),
                target=str(payload.get("target") or "traced_fix_within_horizon"),
                finder_checks=fc,
            )
    except (OSError, json.JSONDecodeError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    print(json.dumps(result, indent=2))
    return 0


def main(argv: list[str] | None = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    if raw_argv and raw_argv[0] == "score":
        return _run_score(raw_argv[1:])

    parser = argparse.ArgumentParser(
        description=(
            "Evaluate structural review gates, capture-recapture saturation, normalized [0, 1) vector risk "
            "brackets, and level-invariant mass-based reviewer allocation. Use `score` subcommand to score vectors."
        ),
    )
    parser.add_argument("input", nargs="?", default="-", help="Path to review ledger JSON file, or '-' for stdin (default: -)")
    parser.add_argument("--calibration", default=os.environ.get("ASTACK_CALIBRATION_FILE", ""), help="Optional calibration.json file")
    parser.add_argument("--outcomes", default=os.environ.get("ASTACK_OUTCOMES_FILE", ""), help="Optional scorer_outcomes.jsonl/.json file for dynamic gap-share learning")
    parser.add_argument("--receipts", action="append", default=[], help="Optional dispatch receipt file or directory (repeatable) to auto-ingest failed/blocked reviewer receipts")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--json", action="store_true", dest="as_json", help="Emit structured JSON output")
    mode.add_argument("--markdown", action="store_true", help="Emit internal Markdown coverage map (default)")
    mode.add_argument("--lanes", action="store_true", help="Emit append-only LANES.md log lines")
    args = parser.parse_args(raw_argv)

    try:
        external_cr: dict[tuple[str, str], CatchRate] = {}
        if args.calibration:
            cal_path = Path(args.calibration).expanduser()
            if cal_path.is_file():
                external_cr = load_calibration_file(str(cal_path))
            elif args.calibration != os.environ.get("ASTACK_CALIBRATION_FILE", ""):
                raise ValidationError(f"calibration file not found: {cal_path}")

        external_outcomes: list = []
        if args.outcomes:
            out_path = Path(args.outcomes).expanduser()
            if out_path.is_file():
                external_outcomes = load_outcomes_file(str(out_path))
            elif args.outcomes != os.environ.get("ASTACK_OUTCOMES_FILE", ""):
                raise ValidationError(f"outcomes file not found: {out_path}")

        external_receipts = load_dispatch_receipts(args.receipts) if args.receipts else []
        raw_text = sys.stdin.read() if args.input == "-" else Path(args.input).read_text(encoding="utf-8")
        payload = json.loads(raw_text)
        result = evaluate_ledger(
            payload,
            external_catch_rates=external_cr,
            external_outcomes=external_outcomes,
            external_receipts=external_receipts,
        )
    except (OSError, json.JSONDecodeError, ValidationError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    if args.as_json:
        print(json.dumps(result, indent=2))
    elif args.lanes:
        for line in result["lanes_log_lines"]:
            print(line)
    else:
        print(format_markdown(result), end="")
    return 0


if __name__ == "__main__":
    sys.exit(main())
