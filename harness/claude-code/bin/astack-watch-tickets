#!/usr/bin/env python3
"""Good-citizen ticket queue watcher and ingester for GitHub Issues, Jira, and Linear.

Thin CLI entrypoint backed by the stdlib-only `astack_tickets` package (`lib/astack_tickets/`).

Usage:
  astack-watch-tickets auth-check --tracker github|jira|linear [--host HOST] [--base-url URL] [--json]
  astack-watch-tickets query --tracker github|jira|linear [--query STR] [--filter-json JSON] [options]
  astack-watch-tickets watch --tracker github|jira|linear [--query STR] [--filter-json JSON] [watch options]
  astack-watch-tickets ingest --tracker github|jira|linear --ticket ID [options]
  astack-watch-tickets status --state-dir DIR [--json]
  astack-watch-tickets mark --state-dir DIR --ticket ID --state STATE [--pr URL] [--note TEXT]

Exit codes:
  0 = matched ticket(s) ready, --once / query / auth-check / status / mark succeeded
  2 = invalid arguments, auth/permission error, query error, or another watcher holds the lock
  8 = timeout, rate-limit reset past --max-wait, or tracker remained unreachable
"""
from __future__ import annotations

from pathlib import Path
import sys

sys.dont_write_bytecode = True


def _bootstrap_lib() -> None:
    here = Path(__file__).resolve().parent
    for candidate in (here.parent / "lib", here / "_astack_lib"):
        if (candidate / "astack_tickets" / "__init__.py").is_file():
            path_str = str(candidate)
            if path_str not in sys.path:
                sys.path.insert(0, path_str)
            return
    sys.stderr.write(
        "error: astack_tickets package not found alongside astack-watch-tickets; "
        "run `astack-tools link-bin` from an astack install\n"
    )
    sys.exit(2)


if __name__ == "__main__":
    _bootstrap_lib()
    from astack_tickets.cli import main

    sys.exit(main())
