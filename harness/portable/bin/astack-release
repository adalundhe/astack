#!/usr/bin/env python3
"""Track, sequence, sync, verify, and roll back multi-repo / multi-step PR merge and deploy trains.

Usage:
  astack-release init FILE --name NAME [--goal TEXT] [--if-missing] [--markdown PATH]
  astack-release load FILE --spec SPEC.json [--markdown PATH]
  astack-release add-step FILE --id ID --kind pr|tag|deploy|verify|manual --title TEXT [options]
  astack-release set-pr FILE --id ID --pr-url URL [--branch BRANCH] [--head-sha SHA] [--markdown PATH]
  astack-release status FILE [--settings PATH] [--json]
  astack-release ready FILE [--settings PATH] [--json]
  astack-release sync FILE [--step ID] [--settings PATH] [--pr-watcher PATH] [--markdown PATH] [--json]
  astack-release start FILE --id ID [--settings PATH] [--note TEXT] [--markdown PATH] [--json]
  astack-release verify FILE --id ID [--run] [--timeout SECONDS] [--note TEXT] [--markdown PATH] [--json]
  astack-release complete FILE --id ID [--output KEY=VALUE ...] [--note TEXT] [--markdown PATH] [--json]
  astack-release fail FILE --id ID --reason TEXT [--markdown PATH] [--json]
  astack-release rollback-plan FILE [--from-step ID] [--json]
  astack-release mark-rolled-back FILE --id ID [--note TEXT] [--markdown PATH] [--json]
  astack-release render FILE [--out PATH]

Stdlib-only (Python >=3.9). Stores state atomically in JSON (write-to-temp + fsync + os.replace),
validates DAG acyclicity and output dependencies, integrates with astack-watch-pr for live PR state,
enforces settings.json autonomy boundaries, resolves upstream outputs for downstream repos, and
renders a Mermaid release-train diagram + reverse-topological rollback runbook.
"""
from __future__ import annotations

import argparse
from collections import deque
from dataclasses import dataclass, field
from datetime import datetime, timezone
from enum import Enum
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import Any, Dict, List, Optional, Sequence, Set, Tuple


STEP_ID_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
OUTPUT_REF_RE = re.compile(r"^([a-z0-9][a-z0-9._-]*)\.([A-Za-z0-9_.-]+)$")
PLACEHOLDER_RE = re.compile(r"\{\{([a-z0-9][a-z0-9._-]*\.[A-Za-z0-9_.-]+)\}\}")

SECRET_PATTERNS = (
    re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----"),
    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    re.compile(r"\bASIA[0-9A-Z]{16}\b"),
    re.compile(r"\bgh[pousr]_[A-Za-z0-9]{20,}\b"),
    re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}\b"),
    re.compile(r"\bglpat-[A-Za-z0-9_-]{16,}\b"),
    re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b"),
    re.compile(r"(?i)\b(?:password|passwd|client_secret|api_secret|private_key)\s*[:=]\s*\S+"),
)

DEFAULT_AUTONOMY_DENY = (
    "merge_pr",
    "push_protected_branch",
    "close_or_delete_others_pr",
    "prod_deploy_or_destructive_migration",
    "spend_money_or_billing_changes",
    "publish_external_release",
    "weaken_verification_gates",
)


class ReleaseError(Exception):
    """Raised on invalid input, broken graph invariants, or disallowed transitions."""


class StepKind(str, Enum):
    PR = "pr"
    TAG = "tag"
    DEPLOY = "deploy"
    VERIFY = "verify"
    MANUAL = "manual"


class Phase(str, Enum):
    EXPAND = "expand"
    SWITCH = "switch"
    CONTRACT = "contract"
    GENERAL = "general"


class StepStatus(str, Enum):
    PENDING = "pending"
    IN_PROGRESS = "in_progress"
    WAITING_HUMAN = "waiting_human"
    VERIFYING = "verifying"
    DONE = "done"
    FAILED = "failed"
    ROLLED_BACK = "rolled_back"


def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def default_settings_path() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg:
        return Path(xdg).expanduser() / "astack" / "settings.json"
    return Path.home() / ".config" / "astack" / "settings.json"


def load_autonomy(settings_path: Optional[Path] = None) -> Dict[str, Any]:
    path = (settings_path or default_settings_path()).expanduser()
    default = {
        "mode": "supervised",
        "allow": [],
        "deny": list(DEFAULT_AUTONOMY_DENY),
    }
    try:
        if not path.is_file():
            return default
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return default
    if not isinstance(raw, dict):
        return default
    autonomy = raw.get("autonomy")
    if not isinstance(autonomy, dict):
        return default
    mode = str(autonomy.get("mode") or "supervised")
    allow = [str(x) for x in autonomy.get("allow", []) if isinstance(x, str)]
    deny = [str(x) for x in autonomy.get("deny", DEFAULT_AUTONOMY_DENY) if isinstance(x, str)]
    return {"mode": mode, "allow": allow, "deny": deny}


def check_no_secrets(label: str, value: str) -> None:
    for pattern in SECRET_PATTERNS:
        if pattern.search(value):
            raise ReleaseError(
                f"refusing to store secret-like value in {label} (matched {pattern.pattern!r}); "
                "store resource identifiers/ARNs/SHAs/refs instead of raw credentials"
            )


def _atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.parent / f".{path.name}.tmp.{os.getpid()}"
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    finally:
        if tmp.exists():
            try:
                tmp.unlink()
            except OSError:
                pass


@dataclass
class ReleaseStep:
    id: str
    kind: StepKind
    title: str
    phase: Phase = Phase.GENERAL
    repo: str = ""
    env: str = ""
    depends_on: List[str] = field(default_factory=list)
    requires_outputs: List[str] = field(default_factory=list)
    pr_url: str = ""
    branch: str = ""
    ref: str = ""
    plan_cmd: str = ""
    gate_cmds: List[str] = field(default_factory=list)
    verify_cmd: str = ""
    rollback_cmd: str = ""
    requires_human: bool = False
    status: StepStatus = StepStatus.PENDING
    pr_state: str = ""
    outputs: Dict[str, str] = field(default_factory=dict)
    note: str = ""
    updated_at: str = ""

    def to_dict(self) -> Dict[str, Any]:
        return {
            "id": self.id,
            "kind": self.kind.value,
            "title": self.title,
            "phase": self.phase.value,
            "repo": self.repo,
            "env": self.env,
            "depends_on": list(self.depends_on),
            "requires_outputs": list(self.requires_outputs),
            "pr_url": self.pr_url,
            "branch": self.branch,
            "ref": self.ref,
            "plan_cmd": self.plan_cmd,
            "gate_cmds": list(self.gate_cmds),
            "verify_cmd": self.verify_cmd,
            "rollback_cmd": self.rollback_cmd,
            "requires_human": bool(self.requires_human),
            "status": self.status.value,
            "pr_state": self.pr_state,
            "outputs": dict(self.outputs),
            "note": self.note,
            "updated_at": self.updated_at,
        }

    @classmethod
    def from_dict(cls, raw: Dict[str, Any]) -> "ReleaseStep":
        if not isinstance(raw, dict):
            raise ReleaseError("each step must be a JSON object")
        step_id = str(raw.get("id") or "").strip()
        if not step_id or not STEP_ID_RE.match(step_id):
            raise ReleaseError(f"invalid step id {step_id!r}; expected lowercase slug matching {STEP_ID_RE.pattern}")
        try:
            kind = StepKind(str(raw.get("kind") or "").strip())
        except ValueError as exc:
            valid = ", ".join(k.value for k in StepKind)
            raise ReleaseError(f"step {step_id!r}: invalid kind {raw.get('kind')!r} (valid: {valid})") from exc
        title = str(raw.get("title") or "").strip()
        if not title:
            raise ReleaseError(f"step {step_id!r}: title is required")
        try:
            phase = Phase(str(raw.get("phase") or Phase.GENERAL.value).strip())
        except ValueError as exc:
            valid = ", ".join(p.value for p in Phase)
            raise ReleaseError(f"step {step_id!r}: invalid phase {raw.get('phase')!r} (valid: {valid})") from exc
        try:
            status = StepStatus(str(raw.get("status") or StepStatus.PENDING.value).strip())
        except ValueError as exc:
            valid = ", ".join(s.value for s in StepStatus)
            raise ReleaseError(f"step {step_id!r}: invalid status {raw.get('status')!r} (valid: {valid})") from exc

        depends_raw = raw.get("depends_on") or []
        if not isinstance(depends_raw, list):
            raise ReleaseError(f"step {step_id!r}: depends_on must be a list")
        depends_on = []
        for dep in depends_raw:
            dep_s = str(dep).strip()
            if dep_s and dep_s not in depends_on:
                depends_on.append(dep_s)

        req_out_raw = raw.get("requires_outputs") or []
        if not isinstance(req_out_raw, list):
            raise ReleaseError(f"step {step_id!r}: requires_outputs must be a list")
        requires_outputs = []
        for item in req_out_raw:
            ref_s = str(item).strip()
            if not OUTPUT_REF_RE.match(ref_s):
                raise ReleaseError(f"step {step_id!r}: invalid requires_outputs ref {ref_s!r}; expected <step_id>.<key>")
            if ref_s not in requires_outputs:
                requires_outputs.append(ref_s)

        outputs_raw = raw.get("outputs") or {}
        if not isinstance(outputs_raw, dict):
            raise ReleaseError(f"step {step_id!r}: outputs must be an object")
        outputs: Dict[str, str] = {}
        for k, v in outputs_raw.items():
            key_s = str(k).strip()
            val_s = str(v)
            check_no_secrets(f"{step_id}.outputs.{key_s}", val_s)
            outputs[key_s] = val_s

        gate_cmds_raw = raw.get("gate_cmds") or []
        if not isinstance(gate_cmds_raw, list):
            raise ReleaseError(f"step {step_id!r}: gate_cmds must be a list")
        gate_cmds = [str(g).strip() for g in gate_cmds_raw if str(g).strip()]

        step = cls(
            id=step_id,
            kind=kind,
            title=title,
            phase=phase,
            repo=str(raw.get("repo") or "").strip(),
            env=str(raw.get("env") or "").strip(),
            depends_on=depends_on,
            requires_outputs=requires_outputs,
            pr_url=str(raw.get("pr_url") or "").strip(),
            branch=str(raw.get("branch") or "").strip(),
            ref=str(raw.get("ref") or "").strip(),
            plan_cmd=str(raw.get("plan_cmd") or "").strip(),
            gate_cmds=gate_cmds,
            verify_cmd=str(raw.get("verify_cmd") or "").strip(),
            rollback_cmd=str(raw.get("rollback_cmd") or "").strip(),
            requires_human=bool(raw.get("requires_human", False)) or (kind == StepKind.MANUAL),
            status=status,
            pr_state=str(raw.get("pr_state") or "").strip(),
            outputs=outputs,
            note=str(raw.get("note") or "").strip(),
            updated_at=str(raw.get("updated_at") or "").strip(),
        )
        return step


@dataclass
class ReleasePlan:
    name: str
    goal: str = ""
    schema_version: int = 1
    created_at: str = ""
    updated_at: str = ""
    steps: List[ReleaseStep] = field(default_factory=list)
    events: List[Dict[str, Any]] = field(default_factory=list)

    def by_id(self) -> Dict[str, ReleaseStep]:
        return {step.id: step for step in self.steps}

    def get_step(self, step_id: str) -> ReleaseStep:
        mapping = self.by_id()
        if step_id not in mapping:
            raise ReleaseError(f"unknown step id {step_id!r}")
        return mapping[step_id]

    def record_event(
        self,
        step_id: str,
        action: str,
        from_status: Optional[str] = None,
        to_status: Optional[str] = None,
        detail: str = "",
    ) -> None:
        now = utc_now()
        self.updated_at = now
        self.events.append({
            "timestamp_utc": now,
            "step_id": step_id,
            "action": action,
            "from_status": from_status,
            "to_status": to_status,
            "detail": detail,
        })

    def to_dict(self) -> Dict[str, Any]:
        return {
            "schema_version": self.schema_version,
            "name": self.name,
            "goal": self.goal,
            "created_at": self.created_at,
            "updated_at": self.updated_at,
            "steps": [step.to_dict() for step in self.steps],
            "events": list(self.events),
        }

    @classmethod
    def from_dict(cls, raw: Dict[str, Any]) -> "ReleasePlan":
        if not isinstance(raw, dict):
            raise ReleaseError("release file must contain a JSON object")
        name = str(raw.get("name") or "").strip()
        if not name:
            raise ReleaseError("release plan requires a non-empty 'name'")
        steps_raw = raw.get("steps") or []
        if not isinstance(steps_raw, list):
            raise ReleaseError("'steps' must be a list")
        steps = [ReleaseStep.from_dict(item) for item in steps_raw]
        events_raw = raw.get("events") or []
        if not isinstance(events_raw, list):
            raise ReleaseError("'events' must be a list")
        now = utc_now()
        plan = cls(
            name=name,
            goal=str(raw.get("goal") or "").strip(),
            schema_version=int(raw.get("schema_version") or 1),
            created_at=str(raw.get("created_at") or now),
            updated_at=str(raw.get("updated_at") or now),
            steps=steps,
            events=[dict(e) for e in events_raw if isinstance(e, dict)],
        )
        validate_graph(plan)
        return plan


def topological_order(plan: ReleasePlan) -> List[str]:
    steps_by_id: Dict[str, ReleaseStep] = {}
    for step in plan.steps:
        if step.id in steps_by_id:
            raise ReleaseError(f"duplicate step id {step.id!r}")
        steps_by_id[step.id] = step

    indegree: Dict[str, int] = {sid: 0 for sid in steps_by_id}
    children: Dict[str, List[str]] = {sid: [] for sid in steps_by_id}
    for step in plan.steps:
        for dep in step.depends_on:
            if dep == step.id:
                raise ReleaseError(f"step {step.id!r} cannot depend on itself")
            if dep not in steps_by_id:
                raise ReleaseError(f"step {step.id!r} depends on unknown step {dep!r}")
            children[dep].append(step.id)
            indegree[step.id] += 1

    # Preserve declaration order among ties via deterministic queue sorting
    order_index = {step.id: idx for idx, step in enumerate(plan.steps)}
    ready = deque(sorted((sid for sid, deg in indegree.items() if deg == 0), key=lambda s: order_index[s]))
    topo: List[str] = []
    while ready:
        current = ready.popleft()
        topo.append(current)
        newly_ready: List[str] = []
        for child in children[current]:
            indegree[child] -= 1
            if indegree[child] == 0:
                newly_ready.append(child)
        for nxt in sorted(newly_ready, key=lambda s: order_index[s]):
            ready.append(nxt)

    if len(topo) != len(steps_by_id):
        stuck = sorted(sid for sid, deg in indegree.items() if deg > 0)
        raise ReleaseError(f"dependency cycle detected involving steps: {', '.join(stuck)}")
    return topo


def ancestors_map(plan: ReleasePlan) -> Dict[str, Set[str]]:
    topo = topological_order(plan)
    by_id = plan.by_id()
    anc: Dict[str, Set[str]] = {}
    for sid in topo:
        parents = set(by_id[sid].depends_on)
        all_anc = set(parents)
        for p in parents:
            all_anc.update(anc[p])
        anc[sid] = all_anc
    return anc


def validate_graph(plan: ReleasePlan) -> List[str]:
    topo = topological_order(plan)
    anc = ancestors_map(plan)
    for step in plan.steps:
        referenced: Set[str] = set(step.requires_outputs)
        for text in (step.title, step.plan_cmd, step.verify_cmd, step.rollback_cmd, step.ref, *step.gate_cmds):
            for match in PLACEHOLDER_RE.findall(text):
                referenced.add(match)
        for ref in sorted(referenced):
            m = OUTPUT_REF_RE.match(ref)
            if not m:
                raise ReleaseError(f"step {step.id!r}: invalid output reference {ref!r}")
            upstream_id = m.group(1)
            if upstream_id not in anc[step.id]:
                raise ReleaseError(
                    f"step {step.id!r} references output {ref!r}, but {upstream_id!r} is not an upstream dependency"
                )
    return topo


def step_gate_reason(step: ReleaseStep, autonomy: Dict[str, Any]) -> Optional[str]:
    deny = set(autonomy.get("deny", []))
    allow = set(autonomy.get("allow", []))
    mode = str(autonomy.get("mode") or "supervised")
    if step.kind == StepKind.MANUAL or step.requires_human:
        return "step requires explicit human action or approval"
    if step.kind == StepKind.DEPLOY:
        env_l = step.env.lower()
        if env_l in ("prod", "production") and "prod_deploy_or_destructive_migration" in deny:
            return "production deploy blocked by autonomy.deny (prod_deploy_or_destructive_migration)"
        if mode != "unattended" and env_l in ("prod", "production"):
            return "production deploy requires human approval in supervised mode"
    if step.kind == StepKind.TAG and "publish_external_release" in deny and step.env.lower() in ("prod", "production", "public"):
        return "external release blocked by autonomy.deny (publish_external_release)"
    if step.kind == StepKind.PR and step.pr_state == "merge_ready" and "merge_pr" in deny:
        return "PR merge requires human action (autonomy.deny: merge_pr)"
    if mode != "unattended" and step.kind == StepKind.DEPLOY and "prod_deploy_or_destructive_migration" not in allow and step.env.lower() in ("prod", "production"):
        return "production deploy requires human sign-off"
    return None


def resolve_step(plan: ReleasePlan, step: ReleaseStep, autonomy: Dict[str, Any]) -> Dict[str, Any]:
    by_id = plan.by_id()
    missing_deps = [dep for dep in step.depends_on if by_id[dep].status != StepStatus.DONE]
    resolved_inputs: Dict[str, str] = {}
    missing_outputs: List[str] = []

    needed_refs: List[str] = list(step.requires_outputs)
    for text in (step.title, step.plan_cmd, step.verify_cmd, step.rollback_cmd, step.ref, *step.gate_cmds):
        for match in PLACEHOLDER_RE.findall(text):
            if match not in needed_refs:
                needed_refs.append(match)

    for ref in needed_refs:
        upstream_id, key = ref.split(".", 1)
        val = by_id[upstream_id].outputs.get(key)
        if val is None:
            missing_outputs.append(ref)
        else:
            resolved_inputs[ref] = val

    def interpolate(text: str) -> str:
        if not text:
            return ""
        return PLACEHOLDER_RE.sub(lambda m: resolved_inputs.get(m.group(1), m.group(0)), text)

    if step.status == StepStatus.PENDING:
        effective = "ready" if (not missing_deps and not missing_outputs) else "blocked"
    else:
        effective = step.status.value

    human_gate = step_gate_reason(step, autonomy)
    return {
        "id": step.id,
        "kind": step.kind.value,
        "phase": step.phase.value,
        "repo": step.repo,
        "env": step.env,
        "title": interpolate(step.title),
        "status": step.status.value,
        "effective_state": effective,
        "depends_on": list(step.depends_on),
        "missing_deps": missing_deps,
        "missing_outputs": missing_outputs,
        "inputs": resolved_inputs,
        "outputs": dict(step.outputs),
        "pr_url": step.pr_url,
        "pr_state": step.pr_state,
        "branch": step.branch,
        "ref": interpolate(step.ref),
        "plan_cmd": interpolate(step.plan_cmd),
        "gate_cmds": [interpolate(g) for g in step.gate_cmds],
        "verify_cmd": interpolate(step.verify_cmd),
        "rollback_cmd": interpolate(step.rollback_cmd),
        "human_gate": human_gate,
        "note": step.note,
    }


def compute_rollback_plan(plan: ReleasePlan, from_step: Optional[str] = None) -> List[Dict[str, Any]]:
    topo = topological_order(plan)
    by_id = plan.by_id()
    active_statuses = {StepStatus.DONE, StepStatus.VERIFYING, StepStatus.IN_PROGRESS, StepStatus.WAITING_HUMAN, StepStatus.FAILED}

    scope: Set[str]
    if from_step:
        plan.get_step(from_step)
        # Include from_step and all transitive dependents (children) plus ancestors that have already run
        children: Dict[str, List[str]] = {sid: [] for sid in by_id}
        for s in plan.steps:
            for d in s.depends_on:
                children[d].append(s.id)
        descendants: Set[str] = set()
        queue = deque([from_step])
        while queue:
            cur = queue.popleft()
            if cur in descendants:
                continue
            descendants.add(cur)
            queue.extend(children[cur])
        scope = descendants
    else:
        scope = set(by_id.keys())

    # Reverse topological order guarantees downstream changes roll back BEFORE upstream roles/schemas!
    rollback_steps: List[Dict[str, Any]] = []
    for sid in reversed(topo):
        if sid not in scope:
            continue
        step = by_id[sid]
        if step.status not in active_statuses:
            continue
        rollback_steps.append({
            "id": step.id,
            "kind": step.kind.value,
            "phase": step.phase.value,
            "repo": step.repo,
            "env": step.env,
            "status": step.status.value,
            "rollback_cmd": step.rollback_cmd or "(manual revert / rollback required — no rollback_cmd set)",
            "verify_cmd": step.verify_cmd,
        })
    return rollback_steps


def render_markdown(plan: ReleasePlan, autonomy: Dict[str, Any]) -> str:
    topo = topological_order(plan)
    by_id = plan.by_id()
    resolved = [resolve_step(plan, by_id[sid], autonomy) for sid in topo]

    lines: List[str] = [f"# Release train: {plan.name}", ""]
    if plan.goal:
        lines.extend([f"**Goal:** {plan.goal}", ""])
    lines.append(f"Updated: `{plan.updated_at}`")
    lines.append("")

    # Mermaid flowchart LR grouped by phase
    lines.append("## Release sequence")
    lines.append("")
    lines.append("```mermaid")
    lines.append("flowchart LR")

    phase_labels = {
        Phase.EXPAND.value: "Phase 1: Expand",
        Phase.SWITCH.value: "Phase 2: Switch & Verify",
        Phase.CONTRACT.value: "Phase 3: Contract",
        Phase.GENERAL.value: "Steps",
    }
    by_phase: Dict[str, List[Dict[str, Any]]] = {}
    for item in resolved:
        by_phase.setdefault(item["phase"], []).append(item)

    node_ids: Dict[str, str] = {}
    for idx, item in enumerate(resolved, 1):
        node_ids[item["id"]] = f"s{idx}"

    def _quote(text: str) -> str:
        return text.replace('"', "'").replace("\n", " ")

    for phase_key in (Phase.EXPAND.value, Phase.SWITCH.value, Phase.CONTRACT.value, Phase.GENERAL.value):
        group = by_phase.get(phase_key)
        if not group:
            continue
        sg_id = f"phase_{phase_key}"
        lines.append(f'  subgraph {sg_id}["{phase_labels[phase_key]}"]')
        for item in group:
            nid = node_ids[item["id"]]
            repo_tag = f" ({item['repo']})" if item["repo"] else ""
            label = _quote(f"{item['id']}{repo_tag} [{item['effective_state']}]")
            lines.append(f'    {nid}["{label}"]')
        lines.append("  end")

    for item in resolved:
        dst = node_ids[item["id"]]
        for dep in item["depends_on"]:
            src = node_ids[dep]
            lines.append(f"  {src} --> {dst}")

    lines.append("  classDef done fill:#d4edda,stroke:#28a745,color:#155724")
    lines.append("  classDef ready fill:#cce5ff,stroke:#007bff,color:#004085")
    lines.append("  classDef active fill:#fff3cd,stroke:#ffc107,color:#856404")
    lines.append("  classDef failed fill:#f8d7da,stroke:#dc3545,color:#721c24")
    lines.append("  classDef blocked fill:#e9ecef,stroke:#6c757d,color:#495057")

    class_buckets: Dict[str, List[str]] = {}
    for item in resolved:
        eff = item["effective_state"]
        cls_name = (
            "done" if eff == "done"
            else "ready" if eff == "ready"
            else "failed" if eff in ("failed", "rolled_back")
            else "blocked" if eff == "blocked"
            else "active"
        )
        class_buckets.setdefault(cls_name, []).append(node_ids[item["id"]])
    for cls_name, members in class_buckets.items():
        lines.append(f"  class {','.join(members)} {cls_name}")
    lines.append("```")
    lines.append("")

    lines.append("## Steps")
    lines.append("")
    lines.append("| Step | Phase | Repo / Env | Kind | State | Depends on | PR / Ref / Gate |")
    lines.append("|---|---|---|---|---|---|---|")
    for item in resolved:
        repo_env = item["repo"] or "-"
        if item["env"]:
            repo_env = f"{repo_env} ({item['env']})" if item["repo"] else item["env"]
        deps = ", ".join(item["depends_on"]) if item["depends_on"] else "-"
        details: List[str] = []
        if item["pr_url"]:
            pr_s = item["pr_url"]
            if item["pr_state"]:
                pr_s += f" ({item['pr_state']})"
            details.append(pr_s)
        if item["ref"]:
            details.append(f"`{item['ref']}`")
        if item["human_gate"] and item["effective_state"] != "done":
            details.append(f"human: {item['human_gate']}")
        detail_str = "; ".join(details) if details else "-"
        lines.append(
            f"| `{item['id']}` | {item['phase']} | {repo_env} | {item['kind']} | "
            f"**{item['effective_state']}** | {deps} | {detail_str} |"
        )
    lines.append("")

    artifacts: List[Tuple[str, str, str]] = []
    for item in resolved:
        for k, v in sorted(item["outputs"].items()):
            artifacts.append((item["id"], k, v))
    if artifacts:
        lines.append("## Verified Cross-Repo Artifacts & Outputs")
        lines.append("")
        lines.append("| Output ref | Value |")
        lines.append("|---|---|")
        for sid, k, v in artifacts:
            lines.append(f"| `{sid}.{k}` | `{v}` |")
        lines.append("")

    rb = compute_rollback_plan(plan)
    if rb:
        lines.append("## Reverse-Order Rollback Plan")
        lines.append("")
        for idx, item in enumerate(rb, 1):
            repo_s = f" [{item['repo']}]" if item["repo"] else ""
            lines.append(f"{idx}. **`{item['id']}`**{repo_s} (`{item['status']}`): `{item['rollback_cmd']}`")
        lines.append("")

    return "\n".join(lines)


def load_plan_file(path: Path) -> ReleasePlan:
    if not path.is_file():
        raise ReleaseError(f"release state file not found: {path}")
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ReleaseError(f"failed to parse {path}: {exc}") from exc
    return ReleasePlan.from_dict(raw)


def save_plan_file(path: Path, plan: ReleasePlan, markdown_path: Optional[Path] = None, autonomy: Optional[Dict[str, Any]] = None) -> None:
    validate_graph(plan)
    _atomic_write(path, json.dumps(plan.to_dict(), indent=2) + "\n")
    if markdown_path is not None:
        auto = autonomy if autonomy is not None else load_autonomy()
        _atomic_write(markdown_path, render_markdown(plan, auto))


def parse_kv(items: Sequence[str]) -> Dict[str, str]:
    parsed: Dict[str, str] = {}
    for item in items:
        if "=" not in item:
            raise ReleaseError(f"invalid --output {item!r}; expected KEY=VALUE")
        k, v = item.split("=", 1)
        k = k.strip()
        if not k:
            raise ReleaseError(f"empty output key in {item!r}")
        check_no_secrets(f"output.{k}", v)
        parsed[k] = v
    return parsed


def _default_pr_watcher() -> Path:
    return Path(__file__).resolve().parent / "astack-watch-pr"


def cmd_init(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    if path.exists():
        if args.if_missing:
            plan = load_plan_file(path)
            print(f"astack-release: {path} already exists ({len(plan.steps)} steps)")
            return 0
        raise ReleaseError(f"{path} already exists (pass --if-missing to keep existing state)")
    now = utc_now()
    plan = ReleasePlan(name=args.name, goal=args.goal or "", created_at=now, updated_at=now)
    plan.record_event("plan", "init", detail=args.name)
    save_plan_file(path, plan, Path(args.markdown).expanduser() if args.markdown else None)
    print(f"Initialized release train {plan.name!r} at {path}")
    return 0


def cmd_load(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    spec_path = Path(args.spec).expanduser()
    if not spec_path.is_file():
        raise ReleaseError(f"spec file not found: {spec_path}")
    try:
        raw = json.loads(spec_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ReleaseError(f"failed to parse spec {spec_path}: {exc}") from exc
    plan = ReleasePlan.from_dict(raw)
    plan.record_event("plan", "load", detail=f"{len(plan.steps)} steps from {spec_path.name}")
    save_plan_file(path, plan, Path(args.markdown).expanduser() if args.markdown else None)
    print(f"Loaded {len(plan.steps)} validated steps for {plan.name!r} into {path}")
    return 0


def cmd_add_step(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    plan = load_plan_file(path)
    depends_on = [s.strip() for s in (args.depends_on or "").split(",") if s.strip()]
    requires_outputs = [s.strip() for s in (args.requires_output or []) if s.strip()]
    step = ReleaseStep.from_dict({
        "id": args.id,
        "kind": args.kind,
        "title": args.title,
        "phase": args.phase,
        "repo": args.repo or "",
        "env": args.env or "",
        "depends_on": depends_on,
        "requires_outputs": requires_outputs,
        "pr_url": args.pr_url or "",
        "branch": args.branch or "",
        "ref": args.ref or "",
        "plan_cmd": args.plan_cmd or "",
        "gate_cmds": [g.strip() for g in (args.gate_cmd or []) if g.strip()],
        "verify_cmd": args.verify_cmd or "",
        "rollback_cmd": args.rollback_cmd or "",
        "requires_human": bool(args.requires_human),
    })
    plan.steps.append(step)
    validate_graph(plan)
    plan.record_event(step.id, "add_step", to_status=step.status.value, detail=step.title)
    save_plan_file(path, plan, Path(args.markdown).expanduser() if args.markdown else None)
    print(f"Added step {step.id!r} ({step.kind.value}, phase={step.phase.value})")
    return 0


def cmd_set_pr(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    plan = load_plan_file(path)
    step = plan.get_step(args.id)
    if step.kind != StepKind.PR:
        raise ReleaseError(f"step {step.id!r} has kind={step.kind.value}, expected 'pr'")
    step.pr_url = args.pr_url.strip()
    if args.branch:
        step.branch = args.branch.strip()
    if args.head_sha:
        step.outputs["head_sha"] = args.head_sha.strip()
    step.updated_at = utc_now()
    prev = step.status.value
    autonomy = load_autonomy(Path(args.settings) if args.settings else None)
    res = resolve_step(plan, step, autonomy)
    if step.status == StepStatus.PENDING and res["effective_state"] == "ready":
        step.status = StepStatus.IN_PROGRESS
    plan.record_event(step.id, "set_pr", from_status=prev, to_status=step.status.value, detail=step.pr_url)
    save_plan_file(path, plan, Path(args.markdown).expanduser() if args.markdown else None, autonomy)
    print(f"Attached PR {step.pr_url} to step {step.id!r} (status={step.status.value})")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    plan = load_plan_file(path)
    autonomy = load_autonomy(Path(args.settings) if args.settings else None)
    topo = topological_order(plan)
    by_id = plan.by_id()
    items = [resolve_step(plan, by_id[sid], autonomy) for sid in topo]
    counts: Dict[str, int] = {}
    for item in items:
        counts[item["effective_state"]] = counts.get(item["effective_state"], 0) + 1
    payload = {
        "name": plan.name,
        "goal": plan.goal,
        "updated_at": plan.updated_at,
        "autonomy_mode": autonomy["mode"],
        "counts": counts,
        "ready": [i["id"] for i in items if i["effective_state"] == "ready"],
        "waiting_human": [i["id"] for i in items if i["effective_state"] == "waiting_human"],
        "failed": [i["id"] for i in items if i["effective_state"] == "failed"],
        "steps": items,
    }
    if args.json:
        print(json.dumps(payload, indent=2))
        return 0
    print(f"Release train: {plan.name} (autonomy={autonomy['mode']})")
    summary = ", ".join(f"{k}={v}" for k, v in sorted(counts.items()))
    print(f"Summary: {summary or 'empty'}")
    for item in items:
        repo_s = f" [{item['repo']}]" if item["repo"] else ""
        extra = []
        if item["missing_deps"]:
            extra.append("waiting on: " + ",".join(item["missing_deps"]))
        if item["missing_outputs"]:
            extra.append("missing outputs: " + ",".join(item["missing_outputs"]))
        if item["pr_state"]:
            extra.append(f"pr={item['pr_state']}")
        if item["human_gate"] and item["effective_state"] != "done":
            extra.append(f"gate: {item['human_gate']}")
        suffix = f" ({'; '.join(extra)})" if extra else ""
        print(f"  - {item['id']}{repo_s} [{item['phase']}/{item['kind']}] -> {item['effective_state']}{suffix}")
    return 0


def cmd_ready(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    plan = load_plan_file(path)
    autonomy = load_autonomy(Path(args.settings) if args.settings else None)
    topo = topological_order(plan)
    by_id = plan.by_id()
    ready_items = [
        res for sid in topo
        for res in (resolve_step(plan, by_id[sid], autonomy),)
        if res["effective_state"] == "ready"
    ]
    if args.json:
        print(json.dumps({"name": plan.name, "ready": ready_items}, indent=2))
        return 0
    if not ready_items:
        print(f"No ready steps in {plan.name!r}.")
        return 0
    for item in ready_items:
        repo_s = f" [{item['repo']}]" if item["repo"] else ""
        gate_s = f" [HUMAN GATE: {item['human_gate']}]" if item["human_gate"] else ""
        print(f"- {item['id']}{repo_s} ({item['phase']}/{item['kind']}): {item['title']}{gate_s}")
        if item["inputs"]:
            for k, v in sorted(item["inputs"].items()):
                print(f"    input {k} = {v}")
        if item["plan_cmd"]:
            print(f"    plan: {item['plan_cmd']}")
        if item["verify_cmd"]:
            print(f"    verify: {item['verify_cmd']}")
    return 0


def cmd_start(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    plan = load_plan_file(path)
    autonomy = load_autonomy(Path(args.settings) if args.settings else None)
    step = plan.get_step(args.id)
    res = resolve_step(plan, step, autonomy)
    if res["missing_deps"] or res["missing_outputs"]:
        raise ReleaseError(
            f"cannot start {step.id!r}: blocked on deps={res['missing_deps']} outputs={res['missing_outputs']}"
        )
    if step.status == StepStatus.DONE:
        raise ReleaseError(f"step {step.id!r} is already done")
    prev = step.status.value
    gate = step_gate_reason(step, autonomy)
    step.status = StepStatus.WAITING_HUMAN if gate else StepStatus.IN_PROGRESS
    if args.note:
        step.note = args.note
    step.updated_at = utc_now()
    plan.record_event(step.id, "start", from_status=prev, to_status=step.status.value, detail=gate or args.note or "")
    save_plan_file(path, plan, Path(args.markdown).expanduser() if args.markdown else None, autonomy)
    out = resolve_step(plan, step, autonomy)
    if args.json:
        print(json.dumps(out, indent=2))
    else:
        print(f"Step {step.id!r}: {prev} -> {step.status.value}" + (f" ({gate})" if gate else ""))
    return 0


def cmd_verify(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    plan = load_plan_file(path)
    autonomy = load_autonomy(Path(args.settings) if args.settings else None)
    step = plan.get_step(args.id)
    res = resolve_step(plan, step, autonomy)
    if res["missing_deps"] or res["missing_outputs"]:
        raise ReleaseError(
            f"cannot verify {step.id!r}: blocked on deps={res['missing_deps']} outputs={res['missing_outputs']}"
        )
    prev = step.status.value
    verify_cmd = res["verify_cmd"]
    if args.run:
        if not verify_cmd:
            raise ReleaseError(f"step {step.id!r} has no verify_cmd to run")
        step.status = StepStatus.VERIFYING
        proc = subprocess.run(
            verify_cmd,
            shell=True,
            capture_output=True,
            text=True,
            timeout=args.timeout,
        )
        snippet = (proc.stdout + proc.stderr).strip()[:1000]
        if proc.returncode == 0:
            step.status = StepStatus.DONE
            step.note = args.note or f"verify passed: {verify_cmd}"
            step.outputs["verify_status"] = "passed"
        else:
            step.status = StepStatus.FAILED
            step.note = f"verify failed (exit {proc.returncode}): {snippet}"
        step.updated_at = utc_now()
        plan.record_event(step.id, "verify_run", from_status=prev, to_status=step.status.value, detail=step.note)
        save_plan_file(path, plan, Path(args.markdown).expanduser() if args.markdown else None, autonomy)
        payload = {"step": resolve_step(plan, step, autonomy), "returncode": proc.returncode, "output": snippet}
        if args.json:
            print(json.dumps(payload, indent=2))
        else:
            print(f"Verify {step.id!r}: exit {proc.returncode} -> {step.status.value}")
        return 0 if proc.returncode == 0 else 1

    step.status = StepStatus.VERIFYING
    if args.note:
        step.note = args.note
    step.updated_at = utc_now()
    plan.record_event(step.id, "verify", from_status=prev, to_status=step.status.value, detail=args.note or "")
    save_plan_file(path, plan, Path(args.markdown).expanduser() if args.markdown else None, autonomy)
    if args.json:
        print(json.dumps(resolve_step(plan, step, autonomy), indent=2))
    else:
        print(f"Step {step.id!r}: {prev} -> {step.status.value}")
    return 0


def cmd_complete(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    plan = load_plan_file(path)
    autonomy = load_autonomy(Path(args.settings) if args.settings else None)
    step = plan.get_step(args.id)
    res = resolve_step(plan, step, autonomy)
    if res["missing_deps"] or res["missing_outputs"]:
        raise ReleaseError(
            f"cannot complete {step.id!r}: blocked on deps={res['missing_deps']} outputs={res['missing_outputs']}"
        )
    new_outputs = parse_kv(args.output or [])
    prev = step.status.value
    step.outputs.update(new_outputs)
    step.status = StepStatus.DONE
    if args.note:
        step.note = args.note
    step.updated_at = utc_now()
    plan.record_event(
        step.id,
        "complete",
        from_status=prev,
        to_status=step.status.value,
        detail=", ".join(f"{k}={v}" for k, v in sorted(new_outputs.items())) or args.note or "",
    )
    save_plan_file(path, plan, Path(args.markdown).expanduser() if args.markdown else None, autonomy)
    newly_ready = [
        sid for sid in topological_order(plan)
        if resolve_step(plan, plan.by_id()[sid], autonomy)["effective_state"] == "ready"
    ]
    payload = {"step": resolve_step(plan, step, autonomy), "ready": newly_ready}
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"Completed {step.id!r}; ready next: {', '.join(newly_ready) if newly_ready else 'none'}")
    return 0


def cmd_fail(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    plan = load_plan_file(path)
    autonomy = load_autonomy(Path(args.settings) if args.settings else None)
    step = plan.get_step(args.id)
    prev = step.status.value
    step.status = StepStatus.FAILED
    step.note = args.reason
    step.updated_at = utc_now()
    plan.record_event(step.id, "fail", from_status=prev, to_status=step.status.value, detail=args.reason)
    save_plan_file(path, plan, Path(args.markdown).expanduser() if args.markdown else None, autonomy)
    rb = compute_rollback_plan(plan)
    payload = {"step": resolve_step(plan, step, autonomy), "rollback_plan": rb}
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"Marked {step.id!r} FAILED: {args.reason}")
        if rb:
            print("Reverse-order rollback plan:")
            for idx, item in enumerate(rb, 1):
                print(f"  {idx}. {item['id']} ({item['status']}): {item['rollback_cmd']}")
    return 0


def cmd_rollback_plan(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    plan = load_plan_file(path)
    rb = compute_rollback_plan(plan, from_step=args.from_step)
    if args.json:
        print(json.dumps({"name": plan.name, "from_step": args.from_step, "rollback_plan": rb}, indent=2))
        return 0
    if not rb:
        print("No active or completed steps require rollback.")
        return 0
    for idx, item in enumerate(rb, 1):
        repo_s = f" [{item['repo']}]" if item["repo"] else ""
        print(f"{idx}. {item['id']}{repo_s} ({item['phase']}/{item['status']}): {item['rollback_cmd']}")
        if item["verify_cmd"]:
            print(f"   verify: {item['verify_cmd']}")
    return 0


def cmd_mark_rolled_back(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    plan = load_plan_file(path)
    autonomy = load_autonomy(Path(args.settings) if args.settings else None)
    step = plan.get_step(args.id)
    prev = step.status.value
    step.status = StepStatus.ROLLED_BACK
    if args.note:
        step.note = args.note
    step.updated_at = utc_now()
    plan.record_event(step.id, "rollback", from_status=prev, to_status=step.status.value, detail=args.note or "")
    save_plan_file(path, plan, Path(args.markdown).expanduser() if args.markdown else None, autonomy)
    if args.json:
        print(json.dumps(resolve_step(plan, step, autonomy), indent=2))
    else:
        print(f"Step {step.id!r}: {prev} -> rolled_back")
    return 0


def _extract_pr_snapshot(raw: Dict[str, Any]) -> Tuple[str, Dict[str, str]]:
    """Parse astack-watch-pr --once --format json output (single PR, snapshots list, or envelope)."""
    pr_state = ""
    outputs: Dict[str, str] = {}
    if isinstance(raw.get("state"), str):
        pr_state = raw["state"].strip()
    elif isinstance(raw.get("decision"), dict) and isinstance(raw["decision"].get("state"), str):
        pr_state = raw["decision"]["state"].strip()
    elif isinstance(raw.get("prs"), list) and raw["prs"]:
        first = raw["prs"][0]
        if isinstance(first, dict):
            return _extract_pr_snapshot(first)

    snap: Dict[str, Any] = raw
    if isinstance(raw.get("snapshot"), dict):
        snap = raw["snapshot"]
    elif isinstance(raw.get("snapshots"), list) and raw["snapshots"]:
        frontier = raw.get("frontier") if isinstance(raw.get("frontier"), dict) else {}
        frontier_num = frontier.get("number")
        chosen = None
        for item in raw["snapshots"]:
            if isinstance(item, dict):
                target = item.get("target") if isinstance(item.get("target"), dict) else {}
                if frontier_num is not None and target.get("number") == frontier_num:
                    chosen = item
                    break
                if chosen is None:
                    chosen = item
        if chosen is not None:
            snap = chosen

    for src_key, dst_key in (
        ("head_sha", "head_sha"),
        ("merge_commit_sha", "merge_sha"),
        ("merge_sha", "merge_sha"),
        ("base_branch", "base_branch"),
        ("head_branch", "head_branch"),
    ):
        val = snap.get(src_key)
        if isinstance(val, str) and val.strip():
            outputs[dst_key] = val.strip()
    return pr_state, outputs


def cmd_sync(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    plan = load_plan_file(path)
    autonomy = load_autonomy(Path(args.settings) if args.settings else None)
    watcher = Path(args.pr_watcher).expanduser() if args.pr_watcher else _default_pr_watcher()
    if not watcher.is_file():
        raise ReleaseError(f"PR watcher not found at {watcher}")

    targets: List[ReleaseStep] = []
    if args.step:
        step = plan.get_step(args.step)
        if step.kind != StepKind.PR or not step.pr_url:
            raise ReleaseError(f"step {step.id!r} must be kind='pr' with a pr_url to sync")
        targets.append(step)
    else:
        for sid in topological_order(plan):
            step = plan.by_id()[sid]
            if step.kind != StepKind.PR or not step.pr_url:
                continue
            if step.status in (StepStatus.DONE, StepStatus.ROLLED_BACK):
                continue
            res = resolve_step(plan, step, autonomy)
            if res["effective_state"] in ("ready", "in_progress", "waiting_human", "verifying"):
                targets.append(step)

    synced: List[Dict[str, Any]] = []
    deny = set(autonomy.get("deny", []))
    for step in targets:
        res = resolve_step(plan, step, autonomy)
        is_dag_blocked = bool(res["missing_deps"] or res["missing_outputs"])
        cmd = [sys.executable, "-B", str(watcher), step.pr_url, "--once", "--format", "json"]
        if not args.pr_watcher:
            cmd.extend(["--release-file", str(path), "--release-step", step.id])
        proc = subprocess.run(cmd, capture_output=True, text=True)
        stdout = proc.stdout.strip()
        if not stdout:
            raise ReleaseError(f"watcher returned no JSON for {step.id!r} (exit {proc.returncode}): {proc.stderr.strip()}")
        try:
            data = json.loads(stdout)
        except json.JSONDecodeError as exc:
            raise ReleaseError(f"watcher returned invalid JSON for {step.id!r}: {exc}") from exc

        pr_state, pr_outputs = _extract_pr_snapshot(data)
        prev = step.status.value
        step.pr_state = pr_state
        for k, v in pr_outputs.items():
            check_no_secrets(f"{step.id}.outputs.{k}", v)
            step.outputs[k] = v

        if pr_state == "merged":
            if "merge_sha" not in step.outputs and "head_sha" in step.outputs:
                step.outputs["merge_sha"] = step.outputs["head_sha"]
            if step.verify_cmd and step.outputs.get("verify_status") != "passed":
                step.status = StepStatus.VERIFYING
                step.note = "PR merged; awaiting post-merge external verification (`astack-release verify --run`)"
            else:
                step.status = StepStatus.DONE
                step.note = "PR merged"
        elif pr_state == "closed":
            step.status = StepStatus.FAILED
            step.note = "PR closed without merge"
        elif is_dag_blocked:
            step.pr_state = "held"
            step.status = StepStatus.PENDING
            step.note = (
                f"PR held: upstream release dependencies not yet done "
                f"(deps={res['missing_deps']}, outputs={res['missing_outputs']})"
            )
        elif pr_state == "held":
            step.status = StepStatus.IN_PROGRESS
            step.note = "PR is held on external gate or hold label"
        elif pr_state == "merge_ready":
            step.status = StepStatus.WAITING_HUMAN if "merge_pr" in deny else StepStatus.IN_PROGRESS
            step.note = "PR is merge-ready; waiting on human merge" if "merge_pr" in deny else "PR is merge-ready"
        else:
            step.status = StepStatus.IN_PROGRESS
            step.note = f"PR state: {pr_state or 'unknown'}"

        step.updated_at = utc_now()
        plan.record_event(step.id, "sync_pr", from_status=prev, to_status=step.status.value, detail=f"pr_state={pr_state}")
        synced.append({
            "id": step.id,
            "pr_url": step.pr_url,
            "pr_state": pr_state,
            "from_status": prev,
            "to_status": step.status.value,
            "outputs": dict(step.outputs),
        })

    save_plan_file(path, plan, Path(args.markdown).expanduser() if args.markdown else None, autonomy)
    newly_ready = [
        sid for sid in topological_order(plan)
        if resolve_step(plan, plan.by_id()[sid], autonomy)["effective_state"] == "ready"
    ]
    payload = {"synced": synced, "ready": newly_ready}
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        for item in synced:
            print(f"Synced {item['id']}: pr_state={item['pr_state']} ({item['from_status']} -> {item['to_status']})")
        print(f"Ready next: {', '.join(newly_ready) if newly_ready else 'none'}")
    return 0


def cmd_render(args: argparse.Namespace) -> int:
    path = Path(args.file).expanduser()
    plan = load_plan_file(path)
    autonomy = load_autonomy(Path(args.settings) if args.settings else None)
    md = render_markdown(plan, autonomy)
    if args.out:
        out_path = Path(args.out).expanduser()
        _atomic_write(out_path, md)
        print(f"Rendered release runbook and Mermaid graph to {out_path}")
    else:
        sys.stdout.write(md)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="astack-release",
        description="Sequence, sync, verify, and roll back multi-repo / multi-step PR merge and deploy trains.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_init = sub.add_parser("init", help="initialize a new release train state file")
    p_init.add_argument("file")
    p_init.add_argument("--name", required=True)
    p_init.add_argument("--goal", default="")
    p_init.add_argument("--if-missing", action="store_true")
    p_init.add_argument("--markdown")

    p_load = sub.add_parser("load", help="load and validate a release train DAG spec from JSON")
    p_load.add_argument("file")
    p_load.add_argument("--spec", required=True)
    p_load.add_argument("--markdown")

    p_add = sub.add_parser("add-step", help="append a validated step to the release train")
    p_add.add_argument("file")
    p_add.add_argument("--id", required=True)
    p_add.add_argument("--kind", required=True, choices=[k.value for k in StepKind])
    p_add.add_argument("--title", required=True)
    p_add.add_argument("--phase", default=Phase.GENERAL.value, choices=[p.value for p in Phase])
    p_add.add_argument("--repo", default="")
    p_add.add_argument("--env", default="")
    p_add.add_argument("--depends-on", default="", help="comma-separated upstream step IDs")
    p_add.add_argument("--requires-output", action="append", default=[], help="upstream <step_id>.<key> ref (repeatable)")
    p_add.add_argument("--pr-url", default="")
    p_add.add_argument("--branch", default="")
    p_add.add_argument("--ref", default="")
    p_add.add_argument("--plan-cmd", default="")
    p_add.add_argument("--gate-cmd", action="append", default=[], help="pre-merge external read-only gate cmd (repeatable)")
    p_add.add_argument("--verify-cmd", default="")
    p_add.add_argument("--rollback-cmd", default="")
    p_add.add_argument("--requires-human", action="store_true")
    p_add.add_argument("--markdown")

    p_pr = sub.add_parser("set-pr", help="attach a PR/MR URL to a pr step")
    p_pr.add_argument("file")
    p_pr.add_argument("--id", required=True)
    p_pr.add_argument("--pr-url", required=True)
    p_pr.add_argument("--branch", default="")
    p_pr.add_argument("--head-sha", default="")
    p_pr.add_argument("--settings")
    p_pr.add_argument("--markdown")

    p_status = sub.add_parser("status", help="show release train status and blocked/ready/human-gated steps")
    p_status.add_argument("file")
    p_status.add_argument("--settings")
    p_status.add_argument("--json", action="store_true")

    p_ready = sub.add_parser("ready", help="list currently unblocked steps with resolved upstream outputs")
    p_ready.add_argument("file")
    p_ready.add_argument("--settings")
    p_ready.add_argument("--json", action="store_true")

    p_sync = sub.add_parser("sync", help="sync active PR steps via astack-watch-pr and unlock downstream steps")
    p_sync.add_argument("file")
    p_sync.add_argument("--step")
    p_sync.add_argument("--settings")
    p_sync.add_argument("--pr-watcher")
    p_sync.add_argument("--markdown")
    p_sync.add_argument("--json", action="store_true")

    p_start = sub.add_parser("start", help="mark a ready step in_progress (or waiting_human if autonomy-gated)")
    p_start.add_argument("file")
    p_start.add_argument("--id", required=True)
    p_start.add_argument("--settings")
    p_start.add_argument("--note", default="")
    p_start.add_argument("--markdown")
    p_start.add_argument("--json", action="store_true")

    p_verify = sub.add_parser("verify", help="mark a step verifying or run its read-only verify_cmd")
    p_verify.add_argument("file")
    p_verify.add_argument("--id", required=True)
    p_verify.add_argument("--run", action="store_true")
    p_verify.add_argument("--timeout", type=int, default=120)
    p_verify.add_argument("--settings")
    p_verify.add_argument("--note", default="")
    p_verify.add_argument("--markdown")
    p_verify.add_argument("--json", action="store_true")

    p_comp = sub.add_parser("complete", help="mark a step done and record immutable upstream outputs")
    p_comp.add_argument("file")
    p_comp.add_argument("--id", required=True)
    p_comp.add_argument("--output", action="append", default=[], help="KEY=VALUE (repeatable)")
    p_comp.add_argument("--settings")
    p_comp.add_argument("--note", default="")
    p_comp.add_argument("--markdown")
    p_comp.add_argument("--json", action="store_true")

    p_fail = sub.add_parser("fail", help="mark a step failed and print the reverse-topological rollback plan")
    p_fail.add_argument("file")
    p_fail.add_argument("--id", required=True)
    p_fail.add_argument("--reason", required=True)
    p_fail.add_argument("--settings")
    p_fail.add_argument("--markdown")
    p_fail.add_argument("--json", action="store_true")

    p_rb = sub.add_parser("rollback-plan", help="compute reverse-topological rollback steps")
    p_rb.add_argument("file")
    p_rb.add_argument("--from-step")
    p_rb.add_argument("--json", action="store_true")

    p_mrb = sub.add_parser("mark-rolled-back", help="mark a step rolled_back")
    p_mrb.add_argument("file")
    p_mrb.add_argument("--id", required=True)
    p_mrb.add_argument("--settings")
    p_mrb.add_argument("--note", default="")
    p_mrb.add_argument("--markdown")
    p_mrb.add_argument("--json", action="store_true")

    p_render = sub.add_parser("render", help="render Markdown runbook + Mermaid flowchart LR release graph")
    p_render.add_argument("file")
    p_render.add_argument("--out")
    p_render.add_argument("--settings")

    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    dispatch = {
        "init": cmd_init,
        "load": cmd_load,
        "add-step": cmd_add_step,
        "set-pr": cmd_set_pr,
        "status": cmd_status,
        "ready": cmd_ready,
        "sync": cmd_sync,
        "start": cmd_start,
        "verify": cmd_verify,
        "complete": cmd_complete,
        "fail": cmd_fail,
        "rollback-plan": cmd_rollback_plan,
        "mark-rolled-back": cmd_mark_rolled_back,
        "render": cmd_render,
    }
    try:
        return dispatch[args.command](args)
    except ReleaseError as err:
        print(f"astack-release: {err}", file=sys.stderr)
        return 2
    except subprocess.TimeoutExpired as err:
        print(f"astack-release: command timed out: {err}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
