#!/usr/bin/env python3
"""GitHub PR watcher (github.com + GitHub Enterprise Server) with good-citizen rate-limit pacing.

Usage:
  astack-watch-github <pr-url-or-number> [--repo owner/name] [watch options]
  astack-watch-github reply <pr-url-or-number> --body-file PATH --audit-receipt PATH [options]

API Citizenship:
  - Consolidates PR metadata, review threads, comments, reviews, check rollup, and GraphQL
    rateLimit into ONE GraphQL query (with pagination only when >100 items).
  - Uses conditional REST ETag/If-None-Match (304 Not Modified = 0 rate-limit cost on GitHub!)
    on idle polls between full GraphQL syncs.
  - Automatically falls back from GraphQL to the separate REST API quota when GraphQL quota
    drops below reserve or hits rate limits.
  - Caches required status checks and PR file lists across polls; honors X-RateLimit-*,
    X-Poll-Interval, and Retry-After headers.
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
from typing import Any, Dict, List, Optional, Sequence, Tuple
from urllib import parse as urllib_parse

sys.dont_write_bytecode = True


def _load_core() -> Any:
    path = Path(__file__).resolve().parent / "astack-watch-pr"
    mod_name = "astack_watch_pr"
    if mod_name in sys.modules:
        return sys.modules[mod_name]
    loader = importlib.machinery.SourceFileLoader(mod_name, str(path))
    spec = importlib.util.spec_from_loader(mod_name, loader)
    if spec is None:
        raise RuntimeError(f"failed to load core module from {path}")
    mod = importlib.util.module_from_spec(spec)
    sys.modules[mod_name] = mod
    loader.exec_module(mod)
    return mod


core = _load_core()

CONSOLIDATED_PR_QUERY = """
query WatchPR($owner: String!, $repo: String!, $number: Int!) {
  rateLimit {
    cost
    remaining
    limit
    resetAt
  }
