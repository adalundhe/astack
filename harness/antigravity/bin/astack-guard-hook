#!/bin/sh
# Fast hook entry point for runtime safety guard (PreToolUse / beforeShellExecution).
# Safe shell commands skip Python startup completely and return in ~1ms.
event=$(cat)
harness=""
prev=""
for arg in "$@"; do
  case "$prev" in
    --harness) harness="$arg"; prev="" ;;
    *)
      case "$arg" in
        --harness) prev="$arg" ;;
      esac
      ;;
  esac
done

case "$event" in
  *"reset"*|*"clean"*|*"push"*|*"rm "*|*"rm	"*|*"pr merge"*|*"mr merge"*|*"DROP "*|*"drop "*|*"TRUNCATE "*|*"truncate "*)
    printf '%s' "$event" | exec "$(dirname "$0")/astack-guard" --hook "$@"
    ;;
  *)
    if [ "$harness" = "antigravity" ]; then
      printf '{}\n'
    elif [ "$harness" = "cursor" ]; then
      printf '{"permission":"allow"}\n'
    fi
    exit 0
    ;;
esac
