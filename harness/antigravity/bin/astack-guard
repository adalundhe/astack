#!/usr/bin/env python3
"""Runtime protective guard hook for astack across Claude Code, Codex, Antigravity, and Cursor.

Usage:
  astack-guard --hook --harness claude-code|codex|antigravity|cursor --event EVENT
  astack-guard check [--cwd DIR] [--settings PATH] [--json] COMMAND

Enforces high-signal safety boundaries before shell execution:
  - Blocks catastrophic filesystem wipes (rm -rf /, ~, ., .., *).
  - Blocks force-pushes to protected branches (main, master, trunk, prod, production, release/*)
    while allowing safe feature-branch `git push --force-with-lease`.
  - Blocks unrecoverable local git wipes (`git reset --hard`, `git clean -fd/-fdx`).
  - Blocks autonomous PR/MR merges (`gh pr merge`, `glab mr merge`) when `merge_pr` is denied
    by `~/.config/astack/settings.json` (default denied).
  - Blocks raw destructive SQL drops (`DROP DATABASE`, `DROP SCHEMA`, `TRUNCATE TABLE`) via DB CLIs.

Stdlib-only (Python >=3.9). Fails open on malformed JSON or unexpected I/O errors so hooks never
brick a host session.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
from typing import Any, Dict, List, Optional, Sequence, Tuple


DEFAULT_DENY = frozenset({
    "merge_pr",
    "push_protected_branch",
    "close_or_delete_others_pr",
    "prod_deploy_or_destructive_migration",
    "spend_money_or_billing_changes",
    "publish_external_release",
    "weaken_verification_gates",
})

PROTECTED_BRANCHES = frozenset({"main", "master", "trunk", "prod", "production"})
PROTECTED_PREFIXES = ("release/", "releases/", "hotfix/")
DB_CLI_BINARIES = frozenset({"psql", "mysql", "mariadb", "sqlite3", "sqlcmd", "clickhouse-client", "mongosh"})
SQL_DESTRUCTIVE_RE = re.compile(
    r"\b(?:DROP\s+(?:DATABASE|SCHEMA)|TRUNCATE\s+TABLE)\b",
    re.IGNORECASE,
)


def default_settings_path() -> Path:
    if override := os.environ.get("ASTACK_SETTINGS_FILE"):
        return Path(override).expanduser()
    if xdg := os.environ.get("XDG_CONFIG_HOME"):
        return Path(xdg).expanduser() / "astack" / "settings.json"
    return Path.home() / ".config" / "astack" / "settings.json"


def load_autonomy_policy(settings_path: Optional[Path] = None) -> Tuple[set[str], set[str]]:
    """Return (allow_set, deny_set) from settings.json, falling back safely to DEFAULT_DENY."""
    path = (settings_path or default_settings_path()).expanduser()
    allow: set[str] = set()
    deny: set[str] = set(DEFAULT_DENY)
    try:
        if not path.is_file():
            return allow, deny
        data = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            return allow, deny
        autonomy = data.get("autonomy")
        if not isinstance(autonomy, dict):
            return allow, deny
        raw_allow = autonomy.get("allow")
        raw_deny = autonomy.get("deny")
        if isinstance(raw_allow, list):
            allow = {str(x).strip() for x in raw_allow if str(x).strip()}
        if isinstance(raw_deny, list):
            deny = {str(x).strip() for x in raw_deny if str(x).strip()}
        # Explicit allow overrides default deny only if user removed it from deny
        deny -= allow
    except (OSError, ValueError):
        return allow, deny
    return allow, deny


def _split_shell_segments(command: str) -> List[List[str]]:
    """Split a shell command string into argv segments separated by &&, ||, ;, |, or newlines.

    Respects single and double quotes so text inside commit messages, echo strings, or python -c
    code is not misclassified as a top-level shell command.
    """
    segments: List[List[str]] = []
    cur: List[str] = []
    buf: List[str] = []
    in_single = False
    in_double = False
    escaped = False
    i = 0
    n = len(command)

    def flush_tok() -> None:
        if buf:
            cur.append("".join(buf))
            buf.clear()

    def flush_seg() -> None:
        flush_tok()
        if cur:
            segments.append(list(cur))
            cur.clear()

    while i < n:
        ch = command[i]
        if escaped:
            buf.append(ch)
            escaped = False
            i += 1
            continue
        if in_single:
            if ch == "'":
                in_single = False
            else:
                buf.append(ch)
            i += 1
            continue
        if in_double:
            if ch == "\\":
                escaped = True
            elif ch == '"':
                in_double = False
            else:
                buf.append(ch)
            i += 1
            continue
        if ch == "\\":
            escaped = True
            i += 1
            continue
        if ch == "'":
            in_single = True
            i += 1
            continue
        if ch == '"':
            in_double = True
            i += 1
            continue
        if ch in (";", "\n"):
            flush_seg()
            i += 1
            continue
        if ch in ("&", "|"):
            if i + 1 < n and command[i + 1] == ch:
                flush_seg()
                i += 2
                continue
            flush_seg()
            i += 1
            continue
        if ch.isspace():
            flush_tok()
            i += 1
            continue
        buf.append(ch)
        i += 1

    flush_seg()
    return segments


def _strip_wrappers(argv: List[str]) -> List[str]:
    """Strip leading env assignments and benign command wrappers (env, command, sudo, timeout)."""
    idx = 0
    while idx < len(argv):
        tok = argv[idx]
        if "=" in tok and not tok.startswith("-") and tok.split("=", 1)[0].replace("_", "").isalnum():
            idx += 1
            continue
        base = os.path.basename(tok)
        if base in ("command", "sudo", "nohup"):
            idx += 1
            while idx < len(argv) and argv[idx].startswith("-"):
                idx += 1
            continue
        if base == "env":
            idx += 1
            while idx < len(argv) and (argv[idx].startswith("-") or "=" in argv[idx]):
                idx += 1
            continue
        if base == "timeout":
            idx += 1
            while idx < len(argv) and argv[idx].startswith("-"):
                idx += 1
            if idx < len(argv):
                idx += 1  # skip duration
            continue
        break
    return argv[idx:]


def _is_protected_branch(branch: str) -> bool:
    name = branch.strip().removeprefix("refs/heads/").removeprefix("origin/")
    if not name:
        return False
    if name in PROTECTED_BRANCHES:
        return True
    return any(name.startswith(pref) for pref in PROTECTED_PREFIXES)


def _current_git_branch(cwd: Optional[str], repo_override: Optional[str] = None) -> str:
    target = repo_override or cwd or ""
    if not target:
        return ""
    try:
        proc = subprocess.run(
            ["git", "-C", target, "rev-parse", "--abbrev-ref", "HEAD"],
            capture_output=True,
            text=True,
            timeout=2,
        )
        if proc.returncode == 0:
            return proc.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return ""


def _check_rm(args: List[str]) -> Optional[Tuple[str, str]]:
    recursive = False
    force = False
    targets: List[str] = []
    after_dd = False
    for tok in args:
        if not after_dd and tok == "--":
            after_dd = True
            continue
        if not after_dd and tok.startswith("--"):
            if tok == "--recursive":
                recursive = True
            elif tok == "--force":
                force = True
            continue
        if not after_dd and tok.startswith("-") and len(tok) > 1:
            flags = tok[1:]
            if "r" in flags or "R" in flags:
                recursive = True
            if "f" in flags:
                force = True
            continue
        targets.append(tok)
    if not (recursive and force):
        return None
    for raw in targets:
        norm = raw.rstrip("/") or ("/" if raw.startswith("/") else "")
        if norm in ("/", "~", "$HOME", "${HOME}", ".", "..", "*", "/*"):
            return (
                "destructive_rm",
                f"Blocked destructive wipe `rm -rf {raw}`. Scope deletions to a specific scratch or build subdirectory.",
            )
    return None


def _check_git(args: List[str], cwd: Optional[str], deny: set[str]) -> Optional[Tuple[str, str]]:
    # Parse global git options before subcommand (e.g. git -C /repo push ...)
    repo_override: Optional[str] = None
    i = 0
    while i < len(args):
        tok = args[i]
        if tok == "-C" and i + 1 < len(args):
            repo_override = args[i + 1]
            i += 2
            continue
        if tok in ("-c", "--git-dir", "--work-tree") and i + 1 < len(args):
            i += 2
            continue
        if tok.startswith("-"):
            i += 1
            continue
        break
    if i >= len(args):
        return None
    sub = args[i]
    rest = args[i + 1 :]

    if sub == "reset" and "--hard" in rest:
        return (
            "destructive_git_reset",
            "Blocked `git reset --hard` because it discards uncommitted work permanently. Use `git stash` or confirm with the user first.",
        )

    if sub == "clean":
        has_force = False
        has_dir_or_ignored = False
        for tok in rest:
            if tok == "--force":
                has_force = True
            elif tok.startswith("-") and not tok.startswith("--"):
                flags = tok[1:]
                if "f" in flags:
                    has_force = True
                if any(c in flags for c in ("d", "x", "X")):
                    has_dir_or_ignored = True
        if has_force and has_dir_or_ignored:
            return (
                "destructive_git_clean",
                "Blocked `git clean -f` with `-d`/`-x` because it deletes untracked files permanently. Run `git clean -nd` to preview or ask the user first.",
            )

    if sub == "push" and "push_protected_branch" in deny:
        is_force = False
        positional: List[str] = []
        skip_next = False
        for tok in rest:
            if skip_next:
                skip_next = False
                continue
            if tok in ("-o", "--push-option", "--repo", "--receive-pack", "--exec"):
                skip_next = True
                continue
            if tok in ("-f", "--force") or tok.startswith("--force-with-lease") or tok == "--force-if-includes":
                is_force = True
                continue
            if tok.startswith("-") and not tok.startswith("--") and "f" in tok[1:]:
                is_force = True
                continue
            if tok.startswith("-"):
                continue
            positional.append(tok)

        refspecs = positional[1:] if len(positional) >= 2 else []
        for ref in refspecs:
            if ref.startswith("+"):
                is_force = True
            dst = ref.lstrip("+").split(":", 1)[-1]
            if is_force and _is_protected_branch(dst):
                return (
                    "push_protected_branch",
                    f"Blocked force-push to protected branch `{dst}` (`autonomy.deny` includes `push_protected_branch`). Push to a feature branch instead.",
                )
        if is_force and not refspecs:
            cur = _current_git_branch(cwd, repo_override=repo_override)
            if _is_protected_branch(cur):
                return (
                    "push_protected_branch",
                    f"Blocked force-push while checked out on protected branch `{cur}` (`autonomy.deny` includes `push_protected_branch`).",
                )
    return None


def _check_forge_merge(cmd: str, args: List[str], deny: set[str]) -> Optional[Tuple[str, str]]:
    if "merge_pr" not in deny:
        return None
    if cmd == "gh" and len(args) >= 2 and args[0] == "pr" and args[1] == "merge":
        return (
            "merge_pr",
            "Blocked `gh pr merge` because `merge_pr` is denied in astack autonomy settings. Hand off merge-ready PRs to the user.",
        )
    if cmd == "glab" and len(args) >= 2 and args[0] == "mr" and args[1] == "merge":
        return (
            "merge_pr",
            "Blocked `glab mr merge` because `merge_pr` is denied in astack autonomy settings. Hand off merge-ready MRs to the user.",
        )
    return None


def _check_db_cli(cmd: str, args: List[str], deny: set[str]) -> Optional[Tuple[str, str]]:
    if "prod_deploy_or_destructive_migration" not in deny:
        return None
    if cmd not in DB_CLI_BINARIES:
        return None
    joined = " ".join(args)
    if SQL_DESTRUCTIVE_RE.search(joined):
        return (
            "prod_deploy_or_destructive_migration",
            f"Blocked destructive SQL statement via `{cmd}` (`DROP DATABASE`/`DROP SCHEMA`/`TRUNCATE TABLE`). Confirm explicitly with the user first.",
        )
    return None


def evaluate_command(
    command: str,
    *,
    cwd: Optional[str] = None,
    settings_path: Optional[Path] = None,
) -> Optional[Dict[str, str]]:
    """Return {'rule': ..., 'reason': ...} if command must be blocked, else None."""
    if not command or not command.strip():
        return None
    _, deny = load_autonomy_policy(settings_path)
    for raw_seg in _split_shell_segments(command):
        seg = _strip_wrappers(raw_seg)
        if not seg:
            continue
        cmd = os.path.basename(seg[0])
        args = seg[1:]
        hit: Optional[Tuple[str, str]] = None
        if cmd == "rm":
            hit = _check_rm(args)
        elif cmd == "git":
            hit = _check_git(args, cwd, deny)
        elif cmd in ("gh", "glab"):
            hit = _check_forge_merge(cmd, args, deny)
        elif cmd in DB_CLI_BINARIES:
            hit = _check_db_cli(cmd, args, deny)
        elif cmd in ("sh", "bash", "zsh") and len(args) >= 2 and args[0] in ("-c", "-lc"):
            nested = evaluate_command(args[1], cwd=cwd, settings_path=settings_path)
            if nested:
                return nested
        if hit:
            return {"rule": hit[0], "reason": f"[astack guard:{hit[0]}] {hit[1]}"}
    return None


def extract_command_and_cwd(event: Dict[str, Any]) -> Tuple[str, str]:
    tool_call = event.get("toolCall") if isinstance(event.get("toolCall"), dict) else {}
    tool_input = (
        event.get("tool_input")
        if isinstance(event.get("tool_input"), dict)
        else (tool_call.get("args") if isinstance(tool_call.get("args"), dict) else {})
    )
    cmd = str(
        tool_input.get("command")
        or tool_input.get("CommandLine")
        or event.get("command")
        or ""
    )
    cwd = str(event.get("cwd") or tool_input.get("Cwd") or "")
    if not cwd:
        for key in ("workspacePaths", "workspace_roots"):
            vals = event.get(key)
            if isinstance(vals, list) and vals and isinstance(vals[0], str):
                cwd = vals[0]
                break
    return cmd, cwd


def format_hook_output(harness: str, event_name: str, blocked: Optional[Dict[str, str]]) -> Dict[str, Any]:
    if not blocked:
        if harness == "cursor":
            return {"permission": "allow"}
        return {}
    reason = blocked["reason"]
    if harness == "antigravity":
        return {"decision": "deny", "reason": reason}
    if harness == "cursor":
        return {"permission": "deny", "user_message": reason, "agent_message": reason}
    return {
        "hookSpecificOutput": {
            "hookEventName": event_name or "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="astack-guard",
        description="Runtime protective PreToolUse/beforeShellExecution guard enforcing astack safety boundaries.",
    )
    parser.add_argument("--hook", action="store_true", help="Run as a lifecycle hook reading JSON from stdin")
    parser.add_argument(
        "--harness",
        choices=("claude-code", "codex", "antigravity", "cursor"),
        default="claude-code",
    )
    parser.add_argument("--event", default="PreToolUse")
    parser.add_argument("--settings", type=Path, default=None, help="Override settings.json path")

    sub = parser.add_subparsers(dest="command")
    p_check = sub.add_parser("check", help="Evaluate a shell command and exit 1 if blocked, 0 if allowed")
    p_check.add_argument("shell_cmd", help="Shell command string to inspect")
    p_check.add_argument("--cwd", default="")
    p_check.add_argument("--settings", type=Path, default=None)
    p_check.add_argument("--json", dest="as_json", action="store_true")
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.hook:
        raw = sys.stdin.read()
        try:
            event = json.loads(raw) if raw.strip() else {}
            if not isinstance(event, dict):
                event = {}
        except ValueError:
            event = {}
        cmd, cwd = extract_command_and_cwd(event)
        blocked = evaluate_command(cmd, cwd=cwd or None, settings_path=args.settings)
        out = format_hook_output(args.harness, args.event, blocked)
        if out or args.harness in ("antigravity", "cursor"):
            sys.stdout.write(json.dumps(out) + "\n")
        return 0

    if args.command == "check":
        blocked = evaluate_command(args.shell_cmd, cwd=args.cwd or None, settings_path=args.settings)
        if args.as_json:
            print(json.dumps({"allowed": blocked is None, "block": blocked}, indent=2))
        elif blocked:
            print(blocked["reason"], file=sys.stderr)
        else:
            print("ALLOWED")
        return 1 if blocked else 0

    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
