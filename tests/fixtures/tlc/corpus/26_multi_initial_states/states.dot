strict digraph DiskGraph {
  1 [label="/\\ seed = \"a\"\n/\\ v = 0", style = filled];
  2 [label="/\\ seed = \"b\"\n/\\ v = 0", style = filled];
  3 [label="/\\ seed = \"c\"\n/\\ v = 0", style = filled];
  4 [label="/\\ v = 1"];
  5 [label="/\\ v = 2"];
  6 [label="/\\ v = 9", color=red, invariant="BoundV"];
  1 -> 4 [label="S1", color="black"];
  4 -> 5 [label="S2", color="black"];
  5 -> 6 [label="Boom", color="black"];
  2 -> 6 [label="FastBoom", color="black"];
  3 -> 4 [label="Join", color="black"];
}
