stateDiagram-v2
    state "/\ gen = 1, /\ replayed = FALSE" as s0
    state "/\ gen = 2, /\ replayed = FALSE" as s1
    state "/\ gen = 3, /\ replayed = FALSE" as s2
    state "/\ gen = 3, /\ replayed = TRUE [VIOLATION: NoTokenReplay]" as s3
    [*] --> s0
    s0 --> s1: Rotate1
    s1 --> s2: Rotate2
    s2 --> s3: AcceptOldGen1
    classDef violation fill:#fee,stroke:#c00,stroke-width:2px
    class s3 violation
