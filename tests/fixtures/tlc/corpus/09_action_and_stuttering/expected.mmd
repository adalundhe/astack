stateDiagram-v2
    state "/\ x = 1, /\ y = 0 (#1) [VIOLATION: TemporalProperty]" as s0
    state "/\ x = 1, /\ y = 0 (#2)" as s1
    state "/\ x = 0, /\ y = 0 [VIOLATION: Monotonic]" as s2
    [*] --> s0
    [*] --> s1
    s0 --> s0: cycle
    s1 --> s2: Drop
    classDef violation fill:#fee,stroke:#c00,stroke-width:2px
    class s0,s2 violation
