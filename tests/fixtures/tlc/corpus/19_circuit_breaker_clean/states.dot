strict digraph DiskGraph {
  1 [label="/\\ cb = \"closed\"", style = filled];
  2 [label="/\\ cb = \"open\""];
  3 [label="/\\ cb = \"half_open\""];
  1 -> 1 [label="Success", color="black"];
  1 -> 2 [label="TripThreshold", color="black"];
  2 -> 3 [label="CooldownElapsed", color="black"];
  3 -> 1 [label="ProbeOk", color="black"];
  3 -> 2 [label="ProbeFail", color="black"];
}
