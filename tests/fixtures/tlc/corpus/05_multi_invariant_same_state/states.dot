strict digraph DiskGraph {
nodesep=0.35;
subgraph cluster_graph {
color="white";
-101 [label="/\\ x = 0\n/\\ y = 0",style = filled]
-101 -> -102 [label="Inc",color="black",fontcolor="black"];
-102 [label="/\\ x = 1\n/\\ y = 0"];
-102 -> -103 [label="Inc",color="black",fontcolor="black"];
-102 -> -101 [label="Reset",color="black",fontcolor="black"];
-103 [label="/\\ x = 2\n/\\ y = 1"];
-103 -> -104 [label="Burst",color="black",fontcolor="black"];
-104 [label="/\\ x = 5\n/\\ y = 5"];
}
}
