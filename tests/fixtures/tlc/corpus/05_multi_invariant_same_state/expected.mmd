stateDiagram-v2
    state "/\ x = 0, /\ y = 0" as s0
    state "/\ x = 1, /\ y = 0" as s1
    state "/\ x = 2, /\ y = 1" as s2
    state "/\ x = 5, /\ y = 5 [VIOLATION: SmallX, SmallY]" as s3
    [*] --> s0
    s0 --> s1: Inc
    s1 --> s2: Inc
    s1 --> s0: Reset
    s2 --> s3: Burst
    classDef violation fill:#fee,stroke:#c00,stroke-width:2px
    class s3 violation
