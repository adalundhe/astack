strict digraph DiskGraph {
  1 [label="/\\ s = \"CLOSED\"", style = filled];
  2 [label="/\\ s = \"LISTEN\""];
  3 [label="/\\ s = \"SYN_RCVD\""];
  4 [label="/\\ s = \"ESTABLISHED\""];
  5 [label="/\\ s = \"FIN_WAIT\""];
  1 -> 2 [label="PassiveOpen", color="black"];
  2 -> 3 [label="RecvSYN", color="black"];
  3 -> 4 [label="RecvACK", color="black"];
  4 -> 5 [label="Close", color="black"];
  5 -> 1 [label="RecvFINACK", color="black"];
}
