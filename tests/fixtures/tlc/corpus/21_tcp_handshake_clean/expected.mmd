stateDiagram-v2
    state "/\ s = 'CLOSED'" as s0
    state "/\ s = 'LISTEN'" as s1
    state "/\ s = 'SYN_RCVD'" as s2
    state "/\ s = 'ESTABLISHED'" as s3
    state "/\ s = 'FIN_WAIT'" as s4
    [*] --> s0
    s0 --> s1: PassiveOpen
    s1 --> s2: RecvSYN
    s2 --> s3: RecvACK
    s3 --> s4: Close
    s4 --> s0: RecvFINACK
