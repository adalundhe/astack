strict digraph DiskGraph {
  -1 [label="/\\ x = 0", style = filled];
  -2 [label="/\\ x = 1"];
  -3 [label="/\\ x = 2"];
  -4 [label="/\\ x = 3"];
  -1 -> -2 [label="Step", color="black"];
  -2 -> -3 [label="Step", color="black"];
  -3 -> -4 [label="Step", color="black"];
  -4 -> -4 [label="Stay", color="black"];
}
