stateDiagram-v2
    state "tag = '(star) -> % %init'" as s0
    state "tag = 'quote \'here\' \\'" as s1
    state "tag = 'end -> state' [VIOLATION: SafeTag]" as s2
    [*] --> s0
    s0 --> s1: Mid
    s1 --> s2: Bad
    s2 --> s2: Stay
    classDef violation fill:#fee,stroke:#c00,stroke-width:2px
    class s2 violation
