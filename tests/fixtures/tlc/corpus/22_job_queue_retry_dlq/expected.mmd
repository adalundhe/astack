stateDiagram-v2
    state "/\ state = 'queued'" as s0
    state "/\ state = 'running'" as s1
    state "/\ state = 'retrying'" as s2
    state "/\ state = 'succeeded'" as s3
    state "/\ state = 'dlq'" as s4
    [*] --> s0
    s0 --> s1: Claim
    s1 --> s3: Ack
    s1 --> s2: TransientErr
    s2 --> s1: Retry
    s2 --> s4: ExhaustRetries
