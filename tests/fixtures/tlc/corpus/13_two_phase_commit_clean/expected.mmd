stateDiagram-v2
    state "/\ tm = 'init', /\ rm = 'working'" as s0
    state "/\ tm = 'init', /\ rm = 'prepared'" as s1
    state "/\ tm = 'committed', /\ rm = 'committed'" as s2
    state "/\ tm = 'aborted', /\ rm = 'aborted'" as s3
    [*] --> s0
    s0 --> s1: Prepare
    s1 --> s2: Commit
    s0 --> s3: Abort
    s1 --> s3: TimeoutAbort
