strict digraph DiskGraph {
  1 [label="/\\ tm = \"init\"\n/\\ rm = \"working\"", style = filled];
  2 [label="/\\ tm = \"init\"\n/\\ rm = \"prepared\""];
  3 [label="/\\ tm = \"committed\"\n/\\ rm = \"committed\""];
  4 [label="/\\ tm = \"aborted\"\n/\\ rm = \"aborted\""];
  1 -> 2 [label="Prepare", color="black"];
  2 -> 3 [label="Commit", color="black"];
  1 -> 4 [label="Abort", color="black"];
  2 -> 4 [label="TimeoutAbort", color="black"];
}
