stateDiagram-v2
    state "/\ step = 0" as s0
    state "/\ step = 1" as s1
    state "/\ step = 2" as s2
    state "/\ step = 3" as s3
    state "/\ step = 4 [VIOLATION: NoJump]" as s4
    [*] --> s0
    s0 --> s1: Slow1
    s1 --> s2: Slow2
    s2 --> s3: Slow3
    s3 --> s4: Slow4
    s0 --> s4: Jump
    classDef violation fill:#fee,stroke:#c00,stroke-width:2px
    class s4 violation
