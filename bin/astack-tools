def normalized_arch() -> str:
    machine = platform.machine().lower()
    if machine in ("aarch64", "arm64"):
        return "arm64"
    if machine in ("x86_64", "amd64", "x64"):
        return "amd64"
    return machine or "unknown"


def default_venv() -> Path:
    if env_venv := os.environ.get("ASTACK_VENV"):
        return Path(env_venv).expanduser()
    if xdg := os.environ.get("XDG_DATA_HOME"):
        return Path(xdg).expanduser() / "astack" / "venv"
    if os.name == "nt":
        local_app = os.environ.get("LOCALAPPDATA")
        base = Path(local_app) if local_app else Path.home() / "AppData" / "Local"
        return base / "astack" / "venv"
    return Path.home() / ".local" / "share" / "astack" / "venv"


def default_bin_dir() -> Path:
    if xdg_bin := os.environ.get("XDG_BIN_HOME"):
        return Path(xdg_bin).expanduser()
    return Path.home() / ".local" / "bin"


_LESSON_SLUG_RE = re.compile(r"^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$")
_WINDOWS_RESERVED_NAMES = frozenset({
    "con", "prn", "aux", "nul",
    *(f"com{i}" for i in range(1, 10)),
    *(f"lpt{i}" for i in range(1, 10)),
})
MAX_LESSON_SLUG_LEN = 100


def astack_home_dir() -> Path:
    if env_home := os.environ.get("ASTACK_HOME"):
        return Path(env_home).expanduser()
    return Path.home() / ".astack"


def _validate_lesson_slug(value: str, label: str) -> str:
    raw = (value or "").strip()
    if not raw:
        raise ValueError(f"{label} must not be empty")
    if len(raw) > MAX_LESSON_SLUG_LEN:
        raise ValueError(f"{label} {raw!r} exceeds {MAX_LESSON_SLUG_LEN} characters (keep paths Windows MAX_PATH-safe)")
    if "/" in raw or "\\" in raw or ".." in raw or not _LESSON_SLUG_RE.fullmatch(raw):
        raise ValueError(
            f"invalid {label} {raw!r}: use lowercase ASCII letters, digits, '.', '_' or '-' "
            "(starting and ending with a letter or digit, no '..' or path separators)"
        )
    stem = raw.split(".", 1)[0]
    if stem in _WINDOWS_RESERVED_NAMES:
        raise ValueError(f"invalid {label} {raw!r}: reserved device name on Windows")
    return raw


def _harden_posix_dir(path: Path) -> str | None:
    """Apply owner-only 0o700 permissions on POSIX filesystems that support chmod; tolerate WSL/FAT/NFS."""
    if os.name == "nt":
        return None
    try:
        st = path.stat()
    except OSError as exc:
        return f"could not stat {path}: {exc}"
    geteuid = getattr(os, "geteuid", None)
    if geteuid is not None and st.st_uid != geteuid():
        return f"{path} is owned by uid {st.st_uid}, not current uid {geteuid()}"
    if stat.S_IMODE(st.st_mode) != 0o700:
        try:
            os.chmod(path, 0o700)
        except OSError as exc:
            return f"could not chmod 0700 on {path} (filesystem may ignore POSIX modes): {exc}"
    return None


def _probe_writable(directory: Path) -> tuple[bool, str | None]:
    probe = directory / f".astack-probe-{os.getpid()}-{uuid.uuid4().hex[:8]}"
    try:
        with open(probe, "w", encoding="utf-8", newline="\n") as fh:
            fh.write("")
    except OSError as exc:
        return False, str(exc)
    finally:
        try:
            probe.unlink(missing_ok=True)
        except OSError:
            pass
    return True, None


def _ensure_private_dir(path: Path, root: Path | None = None) -> tuple[bool, str | None]:
    """Create a user-private directory safely across Windows, macOS, and Linux."""
    if path.exists() and not path.is_dir():
        raise OSError(f"{path} exists and is not a directory")
    if path.is_symlink() and not path.exists():
        raise OSError(f"{path} is a broken symlink")
    created = not path.exists()
    if os.name == "nt":
        path.mkdir(parents=True, exist_ok=True)
    else:
        path.mkdir(parents=True, exist_ok=True, mode=0o700)
    if root is not None:
        resolved_root = root.resolve()
        resolved_path = path.resolve()
        if not resolved_path.is_relative_to(resolved_root):
            raise OSError(f"refusing path outside astack home ({resolved_root}): {resolved_path}")
    warning = _harden_posix_dir(path)
    return created, warning


def inspect_astack_home(home_dir: Path | None = None) -> dict:
    target = (home_dir or astack_home_dir()).expanduser()
    try:
        exists = target.exists()
        is_dir = target.is_dir() if exists else False
    except OSError:
        exists = False
        is_dir = False
    mode: str | None = None
    if is_dir:
        if os.name == "nt":
            mode = "windows-user-profile"
        else:
            try:
                mode = oct(stat.S_IMODE(target.stat().st_mode))
            except OSError:
                mode = None
    return {
        "path": str(target),
        "exists": exists,
        "is_dir": is_dir,
        "mode": mode,
    }


def cmd_init_home(args) -> int:
    target = astack_home_dir()
    if args.dry_run:
        info = {
            "astack_home": str(target),
            "exists": target.is_dir(),
            "dry_run": True,
            "platform": sys.platform,
        }
        if args.as_json:
            print(json.dumps(info, indent=2))
        else:
            action = "exists" if target.is_dir() else "would create"
            print(f"dry-run: {action} {target}")
        return 0
    try:
        created, warning = _ensure_private_dir(target)
    except OSError as exc:
        print(f"error: failed to initialize {target}: {exc}", file=sys.stderr)
        return 1
    writable, write_err = _probe_writable(target)
    if not writable:
        hint = (
            f"Fix directory permissions on {target} (check NTFS ACLs / folder ownership)."
            if os.name == "nt"
            else f"Fix ownership/permissions on {target} (e.g., `chown -R $(id -un) {shlex.quote(str(target))} && chmod 700 {shlex.quote(str(target))}`)."
        )
        print(f"error: {target} is not writable ({write_err}). {hint}", file=sys.stderr)
        return 1
    status = inspect_astack_home(target)
    result = {
        "astack_home": status["path"],
        "created": created,
        "writable": True,
        "mode": status["mode"],
        "warning": warning,
        "platform": sys.platform,
    }
    if args.as_json:
        print(json.dumps(result, indent=2))
    else:
        verb = "created" if created else "ready"
        mode_note = f" ({status['mode']})" if status["mode"] else ""
        print(f"astack home {verb}: {status['path']}{mode_note}")
        if warning:
            print(f"warning: {warning}", file=sys.stderr)
    return 0


def cmd_lessons_path(args) -> int:
    try:
        project = _validate_lesson_slug(args.project, "project_name")
        lesson = _validate_lesson_slug(args.lesson, "lesson_name") if args.lesson else None
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    root = astack_home_dir()
    project_dir = root / project
    lessons_dir = project_dir / "lessons"
    target_dir = (lessons_dir / lesson) if lesson else lessons_dir
    output_path = (target_dir / "LESSON.md") if lesson else lessons_dir
    if root.exists():
        resolved_root = root.resolve()
        for existing in (project_dir, lessons_dir, target_dir):
            if existing.exists() and not existing.resolve().is_relative_to(resolved_root):
                print(f"error: refusing path outside astack home ({resolved_root}): {existing.resolve()}", file=sys.stderr)
                return 1
    if args.ensure:
        try:
            _ensure_private_dir(root)
            dirs_to_ensure = (project_dir, lessons_dir, target_dir) if lesson else (project_dir, lessons_dir)
            for directory in dirs_to_ensure:
                _ensure_private_dir(directory, root=root)
        except OSError as exc:
            print(f"error: failed to create lesson directory {target_dir}: {exc}", file=sys.stderr)
            return 1
        writable, write_err = _probe_writable(target_dir)
        if not writable:
            print(f"error: {target_dir} is not writable ({write_err})", file=sys.stderr)
            return 1
    print(output_path)
    return 0


_AD_FILE_RE = re.compile(r"^AD_(\d+)\.md$")


def cmd_arch_path(args) -> int:
    try:
        project = _validate_lesson_slug(args.project, "project_name")
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    if args.number is not None and args.next:
        print("error: pass either NUMBER or --next, not both", file=sys.stderr)
        return 2
    if args.number is not None and args.number < 1:
        print("error: AD number must be a positive integer", file=sys.stderr)
        return 2
    root = astack_home_dir()
    project_dir = root / project
    arch_dir = project_dir / "architecture"
    if root.exists():
        resolved_root = root.resolve()
        for existing in (project_dir, arch_dir):
            if existing.exists() and not existing.resolve().is_relative_to(resolved_root):
                print(f"error: refusing path outside astack home ({resolved_root}): {existing.resolve()}", file=sys.stderr)
                return 1
    if args.ensure:
        try:
            _ensure_private_dir(root)
            for directory in (project_dir, arch_dir):
                _ensure_private_dir(directory, root=root)
        except OSError as exc:
            print(f"error: failed to create architecture directory {arch_dir}: {exc}", file=sys.stderr)
            return 1
        writable, write_err = _probe_writable(arch_dir)
        if not writable:
            print(f"error: {arch_dir} is not writable ({write_err})", file=sys.stderr)
            return 1
    if args.next:
        highest = 0
        try:
            if arch_dir.is_dir():
                for item in arch_dir.iterdir():
                    m = _AD_FILE_RE.match(item.name)
                    if m:
                        highest = max(highest, int(m.group(1)))
        except OSError as exc:
            print(f"error: failed to inspect {arch_dir}: {exc}", file=sys.stderr)
            return 1
        output_path = arch_dir / f"AD_{highest + 1}.md"
    elif args.number is not None:
        output_path = arch_dir / f"AD_{args.number}.md"
    else:
        output_path = arch_dir
    print(output_path)
    return 0


def cmd_arch_list(args) -> int:
    root = astack_home_dir()
    project_filter = None
    if args.project:
        try:
            project_filter = _validate_lesson_slug(args.project, "project_name")
        except ValueError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 2

    entries: list[dict[str, object]] = []
    try:
        root_is_dir = root.is_dir()
    except OSError:
        root_is_dir = False
    if root_is_dir:
        resolved_root = root.resolve()
        try:
            project_dirs = sorted(p for p in root.iterdir() if p.is_dir())
        except OSError:
            project_dirs = []
        for proj_dir in project_dirs:
            if not proj_dir.resolve().is_relative_to(resolved_root):
                continue
            proj = proj_dir.name
            if project_filter and proj != project_filter:
                continue
            arch_dir = proj_dir / "architecture"
            try:
                if not arch_dir.is_dir() or not arch_dir.resolve().is_relative_to(resolved_root):
                    continue
                files = sorted(arch_dir.iterdir(), key=lambda p: p.name)
            except OSError:
                continue
            for ad_file in files:
                m = _AD_FILE_RE.match(ad_file.name)
                if not m or not ad_file.is_file():
                    continue
                try:
                    text = ad_file.read_text(encoding="utf-8", errors="replace")
                except OSError:
                    continue
                fm = _parse_lesson_front_matter(text)
                ad_num = int(m.group(1))
                status_line = ""
                sm = re.search(r"^##\s+Status[^\n]*\n+([^\n#]+)", text, re.M)
                if sm:
                    status_line = sm.group(1).strip()
                entries.append({
                    "project": proj,
                    "ad_number": ad_num,
                    "name": str(fm.get("name") or f"AD-{ad_num}"),
                    "description": str(fm.get("description") or ""),
                    "status": status_line,
                    "path": str(ad_file),
                })

    entries.sort(key=lambda e: (str(e["project"]), int(e["ad_number"])))
    if args.as_json:
        print(json.dumps({"astack_home": str(root), "decisions": entries}, indent=2))
        return 0
    if not entries:
        print(f"No architecture decisions found under {root}.")
        return 0
    for ent in entries:
        st = f" [{ent['status']}]" if ent["status"] else ""
        desc = f" — {ent['description']}" if ent["description"] else ""
        print(f"{ent['project']}/AD_{ent['ad_number']} ({ent['name']}){st}{desc}  ({ent['path']})")
    return 0


_REVIEW_DT_RE = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$")
_REVIEW_VERDICT_RE = re.compile(r"(?:^|\n)\s*VERDICT\s*:\s*([^\n]+)", re.IGNORECASE)


def _validate_review_date_time(value: str) -> str:
    raw = (value or "").strip()
    if not raw:
        raise ValueError("date_time must not be empty")
    if len(raw) > MAX_LESSON_SLUG_LEN:
        raise ValueError(f"date_time {raw!r} exceeds {MAX_LESSON_SLUG_LEN} characters")
    if "/" in raw or "\\" in raw or ":" in raw or ".." in raw or not _REVIEW_DT_RE.fullmatch(raw):
        raise ValueError(
            f"invalid date_time {raw!r}: use Windows-safe UTC timestamp or slug "
            "(ASCII letters, digits, '.', '_' or '-', e.g. 2026-11-25T16-20-00Z; no ':' or path separators)"
        )
    stem = raw.split(".", 1)[0].lower()
    if stem in _WINDOWS_RESERVED_NAMES:
        raise ValueError(f"invalid date_time {raw!r}: reserved device name on Windows")
    return raw


def cmd_reviews_path(args) -> int:
    try:
        project = _validate_lesson_slug(args.project, "project_name")
        dt_slug = _validate_review_date_time(args.date_time) if args.date_time else None
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    if dt_slug is not None and args.new:
        print("error: pass either DATE_TIME or --new, not both", file=sys.stderr)
        return 2
    root = astack_home_dir()
    project_dir = root / project
    reviews_dir = project_dir / "reviews"
    if root.exists():
        resolved_root = root.resolve()
        for existing in (project_dir, reviews_dir):
            if existing.exists() and not existing.resolve().is_relative_to(resolved_root):
                print(f"error: refusing path outside astack home ({resolved_root}): {existing.resolve()}", file=sys.stderr)
                return 1
    if args.new:
        base_dt = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H-%M-%SZ")
        candidate = reviews_dir / base_dt
        suffix = 2
        while candidate.exists():
            candidate = reviews_dir / f"{base_dt}-{suffix}"
            suffix += 1
        target_dir = candidate
    elif dt_slug is not None:
        target_dir = reviews_dir / dt_slug
    else:
        target_dir = reviews_dir
    if root.exists() and target_dir.exists():
        resolved_root = root.resolve()
        if not target_dir.resolve().is_relative_to(resolved_root):
            print(f"error: refusing path outside astack home ({resolved_root}): {target_dir.resolve()}", file=sys.stderr)
            return 1
    if args.ensure:
        try:
            _ensure_private_dir(root)
            dirs_to_ensure = (project_dir, reviews_dir, target_dir) if target_dir != reviews_dir else (project_dir, reviews_dir)
            for directory in dirs_to_ensure:
                _ensure_private_dir(directory, root=root)
        except OSError as exc:
            print(f"error: failed to create review evidence directory {target_dir}: {exc}", file=sys.stderr)
            return 1
        writable, write_err = _probe_writable(target_dir)
        if not writable:
            print(f"error: {target_dir} is not writable ({write_err})", file=sys.stderr)
            return 1
    print(target_dir)
    return 0


def cmd_reviews_list(args) -> int:
    root = astack_home_dir()
    project_filter = None
    if args.project:
        try:
            project_filter = _validate_lesson_slug(args.project, "project_name")
        except ValueError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 2
    limit = args.limit if args.limit and args.limit > 0 else None

    entries: list[dict[str, object]] = []
    try:
        root_is_dir = root.is_dir()
    except OSError:
        root_is_dir = False
    if root_is_dir:
        resolved_root = root.resolve()
        try:
            project_dirs = sorted(p for p in root.iterdir() if p.is_dir() and not p.name.startswith("."))
        except OSError:
            project_dirs = []
        for proj_dir in project_dirs:
            try:
                if not proj_dir.resolve().is_relative_to(resolved_root):
                    continue
            except OSError:
                continue
            proj = proj_dir.name
            if project_filter and proj != project_filter:
                continue
            reviews_dir = proj_dir / "reviews"
            try:
                if not reviews_dir.is_dir() or not reviews_dir.resolve().is_relative_to(resolved_root):
                    continue
                bundles = sorted(
                    (d for d in reviews_dir.iterdir() if d.is_dir() and not d.name.startswith(".")),
                    key=lambda p: p.name,
                    reverse=True,
                )
            except OSError:
                continue
            for bundle_dir in bundles:
                try:
                    if not bundle_dir.resolve().is_relative_to(resolved_root):
                        continue
                    artifacts = sorted(
                        str(f.relative_to(bundle_dir).as_posix())
                        for f in bundle_dir.rglob("*")
                        if f.is_file() and not any(part.startswith(".") for part in f.relative_to(bundle_dir).parts)
                    )
                except OSError:
                    continue
                verdict = ""
                for candidate_name in ("REVIEW.md", "audit-receipt.txt", "audit-receipt.md"):
                    cand = bundle_dir / candidate_name
                    if cand.is_file():
                        try:
                            matches = _REVIEW_VERDICT_RE.findall(cand.read_text(encoding="utf-8", errors="replace"))
                            if matches:
                                verdict = matches[-1].strip()
                                break
                        except OSError:
                            pass
                if not verdict:
                    for rel in artifacts:
                        low = rel.lower()
                        if "receipt" in low or "audit" in low or "review" in low:
                            try:
                                matches = _REVIEW_VERDICT_RE.findall((bundle_dir / rel).read_text(encoding="utf-8", errors="replace"))
                                if matches:
                                    verdict = matches[-1].strip()
                                    break
                            except OSError:
                                pass
                entries.append({
                    "project": proj,
                    "date_time": bundle_dir.name,
                    "path": str(bundle_dir),
                    "artifact_count": len(artifacts),
                    "artifacts": artifacts,
                    "verdict": verdict,
                })

    entries.sort(key=lambda e: (str(e["date_time"]), str(e["project"])), reverse=True)
    if limit is not None:
        entries = entries[:limit]
    if args.as_json:
        print(json.dumps({"astack_home": str(root), "reviews": entries}, indent=2))
        return 0
    if not entries:
        scope = f" for project {project_filter}" if project_filter else ""
        print(f"No review evidence bundles found{scope} under {root}.")
        return 0
    for ent in entries:
        vpart = f" [{ent['verdict']}]" if ent["verdict"] else ""
        print(f"{ent['project']}/{ent['date_time']}{vpart} ({ent['artifact_count']} artifact(s)): {ent['path']}")
    return 0


def cmd_repros_path(args) -> int:
    try:
        project = _validate_lesson_slug(args.project, "project_name")
        repro = _validate_lesson_slug(args.repro, "repro_name") if args.repro else None
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    root = astack_home_dir()
    project_dir = root / project
    repros_dir = project_dir / "repros"
    target_dir = (repros_dir / repro) if repro else repros_dir
    if root.exists():
        resolved_root = root.resolve()
        for existing in (project_dir, repros_dir, target_dir):
            if existing.exists() and not existing.resolve().is_relative_to(resolved_root):
                print(f"error: refusing path outside astack home ({resolved_root}): {existing.resolve()}", file=sys.stderr)
                return 1
    if args.ensure:
        try:
            _ensure_private_dir(root)
            dirs_to_ensure = (project_dir, repros_dir, target_dir) if repro else (project_dir, repros_dir)
            for directory in dirs_to_ensure:
                _ensure_private_dir(directory, root=root)
        except OSError as exc:
            print(f"error: failed to create repro directory {target_dir}: {exc}", file=sys.stderr)
            return 1
        writable, write_err = _probe_writable(target_dir)
        if not writable:
            print(f"error: {target_dir} is not writable ({write_err})", file=sys.stderr)
            return 1
    print(target_dir)
    return 0


def cmd_repros_list(args) -> int:
    root = astack_home_dir()
    project_filter = None
    if args.project:
        try:
            project_filter = _validate_lesson_slug(args.project, "project_name")
        except ValueError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 2

    entries: list[dict[str, object]] = []
    try:
        root_is_dir = root.is_dir()
    except OSError:
        root_is_dir = False
    if root_is_dir:
        resolved_root = root.resolve()
        try:
            project_dirs = sorted(p for p in root.iterdir() if p.is_dir() and not p.name.startswith("."))
        except OSError:
            project_dirs = []
        for proj_dir in project_dirs:
            try:
                if not proj_dir.resolve().is_relative_to(resolved_root):
                    continue
            except OSError:
                continue
            proj = proj_dir.name
            if project_filter and proj != project_filter:
                continue
            repros_dir = proj_dir / "repros"
            try:
                if not repros_dir.is_dir() or not repros_dir.resolve().is_relative_to(resolved_root):
                    continue
                children = sorted(
                    (c for c in repros_dir.iterdir() if not c.name.startswith(".")),
                    key=lambda p: p.name,
                )
            except OSError:
                continue
            for item in children:
                try:
                    if not item.resolve().is_relative_to(resolved_root):
                        continue
                except OSError:
                    continue
                if item.is_dir():
                    try:
                        files = sorted(
                            str(f.relative_to(item).as_posix())
                            for f in item.rglob("*")
                            if f.is_file() and not any(part.startswith(".") for part in f.relative_to(item).parts)
                        )
                    except OSError:
                        files = []
                    entries.append({
                        "project": proj,
                        "repro": item.name,
                        "path": str(item),
                        "file_count": len(files),
                        "files": files,
                    })
                elif item.is_file():
                    entries.append({
                        "project": proj,
                        "repro": item.name,
                        "path": str(item),
                        "file_count": 1,
                        "files": [item.name],
                    })

    entries.sort(key=lambda e: (str(e["project"]), str(e["repro"])))
    if args.as_json:
        print(json.dumps({"astack_home": str(root), "repros": entries}, indent=2))
        return 0
    if not entries:
        scope = f" for project {project_filter}" if project_filter else ""
        print(f"No saved repros found{scope} under {root}.")
        return 0
    for ent in entries:
        print(f"{ent['project']}/{ent['repro']} ({ent['file_count']} file(s)): {ent['path']}")
    return 0


AUTOMATION_RUNNERS = ("werkflow", "orchestral", "taskex")
_AUTOMATION_ALLOWED_DOTFILES = frozenset({".werkflow.json", ".werkflow.json.example"})


def _is_visible_automation_file(rel: Path) -> bool:
    parts = rel.parts
    if not parts:
        return False
    if "__pycache__" in parts or rel.suffix == ".pyc":
        return False
    for part in parts[:-1]:
        if part.startswith("."):
            return False
    leaf = parts[-1]
    if leaf.startswith(".") and leaf not in _AUTOMATION_ALLOWED_DOTFILES:
        return False
    return True


def _infer_automation_runner(auto_dir: Path, files: list[str]) -> tuple[str, str]:
    py_files = [f for f in files if f.endswith(".py")]
    top_py = [f for f in py_files if "/" not in f and f != "__init__.py" and not f.startswith("test_")]
    ordered_py = top_py + [f for f in py_files if f not in top_py]
    fallback_werkflow_mod = ""
    for rel in ordered_py:
        try:
            text = (auto_dir / rel).read_text(encoding="utf-8", errors="replace")[:16384]
        except OSError:
            continue
        if re.search(r"(?:^|\n)\s*(?:from|import)\s+werkflow\b", text):
            return "werkflow", rel
        if re.search(r"(?:^|\n)\s*(?:from|import)\s+orchestral\b", text):
            return "orchestral", rel
        if re.search(r"(?:^|\n)\s*(?:from|import)\s+taskex\b", text):
            return "taskex", rel
        if not fallback_werkflow_mod and re.search(r"(?:^|\n)\s*(?:from|import)\s+werkflow_[a-z0-9_]+\b", text):
            fallback_werkflow_mod = rel
    if fallback_werkflow_mod or ".werkflow.json" in files or ".werkflow.json.example" in files:
        return "werkflow", (fallback_werkflow_mod or (ordered_py[0] if ordered_py else ""))
    return "unknown", (ordered_py[0] if ordered_py else "")


def _inspect_automation_dir(auto_dir: Path, project: str) -> dict[str, object]:
    try:
        files = sorted(
            str(f.relative_to(auto_dir).as_posix())
            for f in auto_dir.rglob("*")
            if f.is_file() and _is_visible_automation_file(f.relative_to(auto_dir))
        )
    except OSError:
        files = []

    meta: dict[str, object] = {}
    manifest = auto_dir / "automation.json"
    if manifest.is_file():
        try:
            parsed = json.loads(manifest.read_text(encoding="utf-8", errors="replace"))
            if isinstance(parsed, dict):
                meta = parsed
        except (OSError, ValueError):
            meta = {}

    inferred_runner, inferred_entry = _infer_automation_runner(auto_dir, files)
    raw_runner = str(meta.get("runner") or "").strip().lower()
    runner = raw_runner if raw_runner in AUTOMATION_RUNNERS else inferred_runner
    entrypoint = str(meta.get("entrypoint") or "").strip() or inferred_entry
    description = str(meta.get("description") or "").strip()
    raw_modules = meta.get("modules")
    modules = (
        [str(m).strip() for m in raw_modules if str(m).strip()]
        if isinstance(raw_modules, list)
        else []
    )
    updated = str(meta.get("updated") or meta.get("created") or "").strip()

    return {
        "project": project,
        "automation": auto_dir.name,
        "runner": runner,
        "entrypoint": entrypoint,
        "description": description,
        "modules": modules,
        "updated": updated,
        "path": str(auto_dir),
        "file_count": len(files),
        "files": files,
    }


def cmd_automations_path(args) -> int:
    try:
        project = _validate_lesson_slug(args.project, "project_name")
        automation = _validate_lesson_slug(args.automation, "automation_name") if args.automation else None
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    root = astack_home_dir()
    project_dir = root / project
    automations_dir = project_dir / "automations"
    target_dir = (automations_dir / automation) if automation else automations_dir
    if root.exists():
        resolved_root = root.resolve()
        for existing in (project_dir, automations_dir, target_dir):
            if existing.exists() and not existing.resolve().is_relative_to(resolved_root):
                print(f"error: refusing path outside astack home ({resolved_root}): {existing.resolve()}", file=sys.stderr)
                return 1
    if args.ensure:
        try:
            _ensure_private_dir(root)
            dirs_to_ensure = (
                (project_dir, automations_dir, target_dir) if automation else (project_dir, automations_dir)
            )
            for directory in dirs_to_ensure:
                _ensure_private_dir(directory, root=root)
        except OSError as exc:
            print(f"error: failed to create automation directory {target_dir}: {exc}", file=sys.stderr)
            return 1
        writable, write_err = _probe_writable(target_dir)
        if not writable:
            print(f"error: {target_dir} is not writable ({write_err})", file=sys.stderr)
            return 1
    print(target_dir)
    return 0


def cmd_automations_list(args) -> int:
    root = astack_home_dir()
    project_filter = None
    if args.project:
        try:
            project_filter = _validate_lesson_slug(args.project, "project_name")
        except ValueError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 2
    runner_filter = (args.runner or "").strip().lower() or None

    entries: list[dict[str, object]] = []
    try:
        root_is_dir = root.is_dir()
    except OSError:
        root_is_dir = False
    if root_is_dir:
        resolved_root = root.resolve()
        try:
            project_dirs = sorted(p for p in root.iterdir() if p.is_dir() and not p.name.startswith("."))
        except OSError:
            project_dirs = []
        for proj_dir in project_dirs:
            try:
                if not proj_dir.resolve().is_relative_to(resolved_root):
                    continue
            except OSError:
                continue
            proj = proj_dir.name
            if project_filter and proj != project_filter:
                continue
            autos_dir = proj_dir / "automations"
            try:
                if not autos_dir.is_dir() or not autos_dir.resolve().is_relative_to(resolved_root):
                    continue
                children = sorted(
                    (c for c in autos_dir.iterdir() if c.is_dir() and not c.name.startswith(".")),
                    key=lambda p: p.name,
                )
            except OSError:
                continue
            for auto_dir in children:
                try:
                    if not auto_dir.resolve().is_relative_to(resolved_root):
                        continue
                except OSError:
                    continue
                info = _inspect_automation_dir(auto_dir, proj)
                if runner_filter and info["runner"] != runner_filter:
                    continue
                entries.append(info)

    entries.sort(key=lambda e: (str(e["project"]), str(e["automation"])))
    if args.as_json:
        print(json.dumps({"astack_home": str(root), "automations": entries}, indent=2))
        return 0
    if not entries:
        scope = f" for project {project_filter}" if project_filter else ""
        rscope = f" ({runner_filter})" if runner_filter else ""
        print(f"No saved automations{rscope} found{scope} under {root}.")
        return 0
    for ent in entries:
        desc = f" — {ent['description']}" if ent["description"] else ""
        entry_note = f" [{ent['entrypoint']}]" if ent["entrypoint"] else ""
        print(f"{ent['project']}/{ent['automation']} [{ent['runner']}]{entry_note}{desc} ({ent['file_count']} file(s)): {ent['path']}")
    return 0


_SAFE_SEGMENT_RE = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$")
_LOGGING_KINDS = ("logs", "traces", "metrics")
_LOGGING_DEFAULT_EXT = {"logs": ".log", "traces": ".trace", "metrics": ".metrics"}
_LOGGING_STAMP_RE = re.compile(r"_\d{4}_\d{2}_\d{2}_\d{2}_\d{2}_\d{2}(?:_\d+)?$")


def _validate_safe_segment(value: str, label: str) -> str:
    raw = (value or "").strip()
    if not raw:
        raise ValueError(f"{label} must not be empty")
    if len(raw) > MAX_LESSON_SLUG_LEN:
        raise ValueError(f"{label} {raw!r} exceeds {MAX_LESSON_SLUG_LEN} characters (keep paths Windows MAX_PATH-safe)")
    if "/" in raw or "\\" in raw or ":" in raw or ".." in raw or not _SAFE_SEGMENT_RE.fullmatch(raw):
        raise ValueError(
            f"invalid {label} {raw!r}: use ASCII letters, digits, '.', '_' or '-' "
            "(starting and ending with a letter or digit, no '..', ':', or path separators)"
        )
    stem = raw.split(".", 1)[0].lower()
    if stem in _WINDOWS_RESERVED_NAMES:
        raise ValueError(f"invalid {label} {raw!r}: reserved device name on Windows")
    return raw


def _validate_rel_subpath(value: str, label: str, *, max_depth: int = 6) -> list[str]:
    raw = (value or "").strip()
    if not raw:
        raise ValueError(f"{label} must not be empty")
    if "\\" in raw or raw.startswith("/") or raw.endswith("/"):
        raise ValueError(f"invalid {label} {raw!r}: use relative '/'-separated segments without leading/trailing slashes")
    parts = raw.split("/")
    if len(parts) > max_depth:
        raise ValueError(f"{label} {raw!r} exceeds maximum depth ({max_depth})")
    return [_validate_safe_segment(part, label) for part in parts]


def _ensure_chain_under_root(root: Path, dirs: list[Path], label: str) -> int:
    try:
        _ensure_private_dir(root)
        for directory in dirs:
            _ensure_private_dir(directory, root=root)
    except OSError as exc:
        print(f"error: failed to create {label} directory {dirs[-1]}: {exc}", file=sys.stderr)
        return 1
    writable, write_err = _probe_writable(dirs[-1])
    if not writable:
        print(f"error: {dirs[-1]} is not writable ({write_err})", file=sys.stderr)
        return 1
    return 0


def _check_chain_within_root(root: Path, paths: list[Path]) -> int:
    if root.exists():
        resolved_root = root.resolve()
        for existing in paths:
            if existing.exists() and not existing.resolve().is_relative_to(resolved_root):
                print(f"error: refusing path outside astack home ({resolved_root}): {existing.resolve()}", file=sys.stderr)
                return 1
    return 0


def _cmd_scoped_tree_path(args, bucket: str, subpath_attr: str, label: str) -> int:
    try:
        project = _validate_lesson_slug(args.project, "project_name")
        raw_sub = getattr(args, subpath_attr, None)
        sub_parts = _validate_rel_subpath(raw_sub, f"{label}_subpath") if raw_sub else []
        file_name = _validate_safe_segment(args.file, "file_name") if args.file else None
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    root = astack_home_dir()
    project_dir = root / project
    base_dir = project_dir / bucket
    dirs = [project_dir, base_dir]
    cur = base_dir
    for part in sub_parts:
        cur = cur / part
        dirs.append(cur)
    output_path = (cur / file_name) if file_name else cur
    check_paths = [*dirs, output_path] if file_name else dirs
    if _check_chain_within_root(root, check_paths) != 0:
        return 1
    if args.ensure:
        if _ensure_chain_under_root(root, dirs, label) != 0:
            return 1
    print(output_path)
    return 0


def _list_scoped_tree(
    root: Path,
    bucket: str,
    *,
    project_filter: str | None = None,
    subdir_parts: list[str] | None = None,
) -> list[dict[str, object]]:
    entries: list[dict[str, object]] = []
    try:
        root_is_dir = root.is_dir()
    except OSError:
        root_is_dir = False
    if not root_is_dir:
        return entries
    resolved_root = root.resolve()
    try:
        project_dirs = sorted(p for p in root.iterdir() if p.is_dir() and not p.name.startswith("."))
    except OSError:
        project_dirs = []
    for proj_dir in project_dirs:
        try:
            if not proj_dir.resolve().is_relative_to(resolved_root):
                continue
        except OSError:
            continue
        proj = proj_dir.name
        if project_filter and proj != project_filter:
            continue
        base_dir = proj_dir / bucket
        scan_dir = base_dir
        for part in (subdir_parts or []):
            scan_dir = scan_dir / part
        try:
            if not scan_dir.is_dir() or not scan_dir.resolve().is_relative_to(resolved_root):
                continue
            children = sorted(
                (c for c in scan_dir.iterdir() if not c.name.startswith(".") and c.name != "__pycache__"),
                key=lambda p: p.name,
            )
        except OSError:
            continue
        for item in children:
            try:
                if not item.resolve().is_relative_to(resolved_root):
                    continue
            except OSError:
                continue
            rel_name = str(item.relative_to(base_dir).as_posix())
            if item.is_dir():
                try:
                    files = sorted(
                        str(f.relative_to(item).as_posix())
                        for f in item.rglob("*")
                        if f.is_file()
                        and "__pycache__" not in f.relative_to(item).parts
                        and f.suffix != ".pyc"
                        and not any(p.startswith(".") for p in f.relative_to(item).parts)
                    )
                except OSError:
                    files = []
                entries.append({
                    "project": proj,
                    "name": rel_name,
                    "kind": "dir",
                    "path": str(item),
                    "file_count": len(files),
                    "files": files,
                })
            elif item.is_file() and item.suffix != ".pyc":
                entries.append({
                    "project": proj,
                    "name": rel_name,
                    "kind": "file",
                    "path": str(item),
                    "file_count": 1,
                    "files": [item.name],
                })
    entries.sort(key=lambda e: (str(e["project"]), str(e["name"])))
    return entries


def cmd_research_path(args) -> int:
    return _cmd_scoped_tree_path(args, "research", "subpath", "research")


def cmd_research_list(args) -> int:
