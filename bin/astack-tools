#!/usr/bin/env python3
"""Install, inspect, link, load, and run astack's Python automation stack (taskex, orchestral, werkflow + werkflow-modules).

Usage:
  astack-tools doctor [--venv DIR] [--json]
  astack-tools init-home [--dry-run] [--json]
  astack-tools lessons path PROJECT [LESSON] [--ensure]
  astack-tools lessons list [--project PROJECT] [--related PROJECT] [--keyword TERM] [--status active|tentative|superseded|all] [--json]
  astack-tools arch path PROJECT [NUMBER | --next] [--ensure]
  astack-tools arch list [--project PROJECT] [--json]
  astack-tools reviews path PROJECT [DATE_TIME | --new] [--ensure]
  astack-tools reviews list [--project PROJECT] [--limit N] [--json]
  astack-tools repros path PROJECT [REPRO] [--ensure]
  astack-tools repros list [--project PROJECT] [--json]
  astack-tools automations path PROJECT [AUTOMATION] [--ensure]
  astack-tools automations list [--project PROJECT] [--runner werkflow|orchestral|taskex] [--json]
  astack-tools research path PROJECT [SUBPATH] [--file FILE] [--ensure]
  astack-tools research list [--project PROJECT] [--json]
  astack-tools docs path PROJECT [SUBDIR] [--file FILE] [--ensure]
  astack-tools docs list [--project PROJECT] [--subdir SUBDIR] [--json]
  astack-tools logging path PROJECT [logs|traces|metrics] [NAME] [--ensure]
  astack-tools logging list [--project PROJECT] [--kind logs|traces|metrics] [--limit N] [--json]
  astack-tools install [--profile core|standard|all] [--modules LIST] [--from-github] [--python SPEC] [--venv DIR] [--dry-run]
  astack-tools link-bin [--bin-dir DIR] [--copy] [--dry-run]
  astack-tools install-agents --harness HARNESS [--settings PATH] [--target DIR] [--dry-run]
  astack-tools enable-claude-skills [--settings PATH] [--dry-run]
  astack-tools skills-dir
  astack-tools skills list --role lead|worker|reviewer|researcher
  astack-tools skills get SKILL
  astack-tools python [--venv DIR] [ARGS...]
  astack-tools werkflow [--venv DIR] [ARGS...]
  astack-tools env [--venv DIR] [--shell sh|powershell|cmd]
  astack-tools path [--venv DIR]

Manages an isolated uv/Python venv (override with ASTACK_VENV or --venv) across macOS, Linux, and Windows
(arm64 and amd64) so automation scripts never pollute a target repository's environment.
"""
