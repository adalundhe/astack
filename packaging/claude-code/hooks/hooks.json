{
  "description": "Auto-recall ~/.astack lessons, stamp lane logs with UTC timestamps, and keep Go mode (Lead role) sticky across prompts and compaction.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/astack-go-hook",
            "args": ["--harness", "claude-code", "--event", "PreToolUse"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/astack-stamp-hook",
            "args": []
          }
        ]
      },
      {
        "matcher": "Skill|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/astack-go-hook",
            "args": ["--harness", "claude-code", "--event", "PostToolUse"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/astack-go-hook",
            "args": ["--harness", "claude-code", "--event", "UserPromptSubmit"]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/astack-go-hook",
            "args": ["--harness", "claude-code", "--event", "SessionStart"]
          }
        ]
      }
    ]
  }
}
