{
  "description": "Auto-recall ~/.astack lessons, stamp lane logs with UTC timestamps, and keep Go mode (Lead role) sticky across prompts and compaction.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/astack-stamp-hook",
            "args": []
          }
        ]
      },
      {
        "matcher": "Skill|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/astack-go-hook --harness claude-code --event PostToolUse",
            "args": []
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/astack-go-hook --harness claude-code --event UserPromptSubmit",
            "args": []
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/astack-go-hook --harness claude-code --event SessionStart",
            "args": []
          }
        ]
      }
    ]
  }
}
